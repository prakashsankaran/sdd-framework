{
  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Intelligent Meeting & Action Management</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] },\n                    colors: { slate: { 950: '#020617' } }\n                }\n            }\n        }\n    </script>\n    <style>\n        .glass { background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); }\n        .glow { box-shadow: 0 0 20px rgba(56, 189, 248, 0.15); }\n    </style>\n</head>\n<body class=\"bg-slate-950 text-slate-200 font-sans min-h-screen\">\n\n<nav class=\"glass sticky top-0 z-50 px-8 py-4 flex justify-between items-center\">\n    <div class=\"flex items-center gap-3\">\n        <div class=\"w-8 h-8 rounded-lg bg-sky-500 flex items-center justify-center\"><i class=\"fas fa-brain text-white\"></i></div>\n        <h1 class=\"text-xl font-bold tracking-tight\">Intelligent Meeting Manager</h1>\n    </div>\n    <div class=\"flex gap-6 text-sm font-medium\">\n        <a href=\"#\" class=\"text-sky-400 border-b-2 border-sky-400 pb-1\">Dashboard</a>\n        <a href=\"#\" class=\"hover:text-sky-400 transition\">Meetings</a>\n        <a href=\"#\" class=\"hover:text-sky-400 transition\">Actions</a>\n    </div>\n</nav>\n\n<main class=\"p-8 max-w-7xl mx-auto\">\n    <!-- Stats Row -->\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\">\n        <div class=\"glass p-6 rounded-2xl\">\n            <p class=\"text-slate-400 text-sm\">Action Closure Rate</p>\n            <h2 class=\"text-3xl font-bold mt-2 text-emerald-400\">84% <span class=\"text-sm font-normal text-slate-500\">+4% this week</span></h2>\n        </div>\n        <div class=\"glass p-6 rounded-2xl\">\n            <p class=\"text-slate-400 text-sm\">Open Action Items</p>\n            <h2 class=\"text-3xl font-bold mt-2 text-white\">12</h2>\n        </div>\n        <div class=\"glass p-6 rounded-2xl\">\n            <p class=\"text-slate-400 text-sm\">AI Insights Generated</p>\n            <h2 class=\"text-3xl font-bold mt-2 text-sky-400\">48</h2>\n        </div>\n    </div>\n\n    <!-- Action Table -->\n    <div class=\"glass rounded-2xl overflow-hidden\">\n        <div class=\"p-6 border-b border-white/5 flex justify-between items-center\">\n            <h3 class=\"font-semibold text-lg\">Active Action Items</h3>\n            <button onclick=\"toggleModal()\" class=\"bg-sky-600 hover:bg-sky-500 text-white px-4 py-2 rounded-lg text-sm transition\">\n                <i class=\"fas fa-plus mr-2\"></i>New Action\n            </button>\n        </div>\n        <table class=\"w-full text-left text-sm\">\n            <thead class=\"bg-white/5 uppercase text-slate-400\">\n                <tr>\n                    <th class=\"px-6 py-4\">Title</th>\n                    <th class=\"px-6 py-4\">Priority</th>\n                    <th class=\"px-6 py-4\">Due Date</th>\n                    <th class=\"px-6 py-4\">Status</th>\n                    <th class=\"px-6 py-4\">Action</th>\n                </tr>\n            </thead>\n            <tbody id=\"action-table-body\">\n                <!-- JS populated -->\n            </tbody>\n        </table>\n    </div>\n</main>\n\n<!-- Modal -->\n<div id=\"modal\" class=\"fixed inset-0 bg-black/80 hidden z-[100] flex items-center justify-center p-4\">\n    <div class=\"glass w-full max-w-lg p-8 rounded-2xl animate-in fade-in zoom-in duration-300\">\n        <h2 class=\"text-xl font-bold mb-6\">Create Action Item</h2>\n        <form id=\"actionForm\" class=\"space-y-4\">\n            <input type=\"text\" id=\"a_title\" placeholder=\"Action Title\" class=\"w-full bg-slate-900 border border-slate-700 p-3 rounded-lg focus:outline-none focus:border-sky-500\" required>\n            <select id=\"a_priority\" class=\"w-full bg-slate-900 border border-slate-700 p-3 rounded-lg\">\n                <option>Critical</option>\n                <option>High</option>\n                <option>Medium</option>\n                <option>Low</option>\n            </select>\n            <input type=\"date\" id=\"a_due\" class=\"w-full bg-slate-900 border border-slate-700 p-3 rounded-lg\">\n            <div class=\"flex gap-4 pt-4\">\n                <button type=\"button\" onclick=\"toggleModal()\" class=\"flex-1 px-4 py-2 border border-slate-700 rounded-lg\">Cancel</button>\n                <button type=\"submit\" class=\"flex-1 bg-sky-600 px-4 py-2 rounded-lg\">Confirm</button>\n            </div>\n        </form>\n    </div>\n</div>\n\n<script>\n    let actions = [\n        { id: 1, title: 'Architectural Review', priority: 'Critical', due: '2023-12-01', status: 'In Progress' },\n        { id: 2, title: 'Compliance Audit Update', priority: 'High', due: '2023-12-05', status: 'Open' }\n    ];\n\n    function renderTable() {\n        const body = document.getElementById('action-table-body');\n        body.innerHTML = actions.map(a => `\n            <tr class=\"border-b border-white/5 hover:bg-white/5 transition\">\n                <td class=\"px-6 py-4 font-medium\">${a.title}</td>\n                <td class=\"px-6 py-4\"><span class=\"px-2 py-1 rounded bg-rose-500/10 text-rose-400 text-xs\">${a.priority}</span></td>\n                <td class=\"px-6 py-4\">${a.due}</td>\n                <td class=\"px-6 py-4\"><span class=\"text-sky-400\">${a.status}</span></td>\n                <td class=\"px-6 py-4\"><button onclick=\"deleteAction(${a.id})\" class=\"text-slate-500 hover:text-red-400\"><i class=\"fas fa-trash\"></i></button></td>\n            </tr>\n        `).join('');\n    }\n\n    function toggleModal() {\n        document.getElementById('modal').classList.toggle('hidden');\n    }\n\n    document.getElementById('actionForm').onsubmit = (e) => {\n        e.preventDefault();\n        actions.push({\n            id: Date.now(),\n            title: document.getElementById('a_title').value,\n            priority: document.getElementById('a_priority').value,\n            due: document.getElementById('a_due').value,\n            status: 'Open'\n        });\n        renderTable();\n        toggleModal();\n        e.target.reset();\n    };\n\n    function deleteAction(id) {\n        actions = actions.filter(a => a.id !== id);\n        renderTable();\n    }\n\n    renderTable();\n</script>\n</body>\n</html>"
}