{
  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Intelligent Meeting Platform | Dashboard</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <script>\n        tailwind.config = { darkMode: 'class', theme: { extend: { fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] } } } }\n    </script>\n    <style>\n        body { background-color: #020617; color: #f1f5f9; }\n        .glass { background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05); }\n    </style>\n</head>\n<body class=\"min-h-screen\">\n\n<nav class=\"glass sticky top-0 z-50 border-b border-slate-800 px-6 py-4 flex items-center justify-between\">\n    <div class=\"flex items-center gap-2\">\n        <div class=\"w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center\"><i class=\"fa-solid fa-brain\"></i></div>\n        <span class=\"text-xl font-bold bg-gradient-to-r from-indigo-400 to-cyan-400 bg-clip-text text-transparent\">InsightMeeting</span>\n    </div>\n    <div class=\"flex items-center gap-6 text-sm font-medium\">\n        <a href=\"#\" class=\"text-indigo-400\">Dashboard</a>\n        <a href=\"#\" class=\"text-slate-400 hover:text-white\">Meetings</a>\n        <a href=\"#\" class=\"text-slate-400 hover:text-white\">Analytics</a>\n        <button onclick=\"toggleModal()\" class=\"bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded-full transition-all text-xs font-bold uppercase tracking-wider\">New Action</button>\n    </div>\n</nav>\n\n<main class=\"p-6 max-w-7xl mx-auto\">\n    <header class=\"mb-8\">\n        <h1 class=\"text-3xl font-bold text-white mb-2\">Executive Overview</h1>\n        <p class=\"text-slate-400\">Real-time risk monitoring and action tracking infrastructure.</p>\n    </header>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\">\n        <div class=\"glass p-6 rounded-2xl border-l-4 border-indigo-500\">\n            <h3 class=\"text-slate-400 text-sm\">Open Action Items</h3>\n            <p class=\"text-3xl font-bold mt-2\">24</p>\n        </div>\n        <div class=\"glass p-6 rounded-2xl border-l-4 border-amber-500\">\n            <h3 class=\"text-slate-400 text-sm\">Risk Detected</h3>\n            <p class=\"text-3xl font-bold mt-2\">3 <span class=\"text-sm font-normal text-amber-500\">High Priority</span></p>\n        </div>\n        <div class=\"glass p-6 rounded-2xl border-l-4 border-emerald-500\">\n            <h3 class=\"text-slate-400 text-sm\">Completion Rate</h3>\n            <p class=\"text-3xl font-bold mt-2\">88%</p>\n        </div>\n    </div>\n\n    <div class=\"glass rounded-2xl overflow-hidden\">\n        <table class=\"w-full text-left\">\n            <thead class=\"bg-slate-900/50\">\n                <tr>\n                    <th class=\"p-4 text-xs font-bold text-slate-400 uppercase tracking-widest\">Title</th>\n                    <th class=\"p-4 text-xs font-bold text-slate-400 uppercase tracking-widest\">Owner</th>\n                    <th class=\"p-4 text-xs font-bold text-slate-400 uppercase tracking-widest\">Due Date</th>\n                    <th class=\"p-4 text-xs font-bold text-slate-400 uppercase tracking-widest\">Status</th>\n                    <th class=\"p-4 text-xs font-bold text-slate-400 uppercase tracking-widest\">Action</th>\n                </tr>\n            </thead>\n            <tbody id=\"actionTable\" class=\"divide-y divide-slate-800\">\n                <!-- Rows injected by JS -->\n            </tbody>\n        </table>\n    </div>\n</main>\n\n<div id=\"modal\" class=\"fixed inset-0 bg-black/80 hidden items-center justify-center z-50\">\n    <div class=\"glass p-8 rounded-2xl w-full max-w-lg shadow-2xl\">\n        <h2 class=\"text-xl font-bold mb-6\">Create New Action Item</h2>\n        <form id=\"actionForm\" class=\"space-y-4\">\n            <div>\n                <label class=\"block text-xs font-bold text-slate-400 mb-1\">TITLE</label>\n                <input type=\"text\" id=\"title\" required class=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 outline-none focus:border-indigo-500\">\n            </div>\n            <div class=\"grid grid-cols-2 gap-4\">\n                <div>\n                    <label class=\"block text-xs font-bold text-slate-400 mb-1\">OWNER EMAIL</label>\n                    <input type=\"email\" id=\"email\" required class=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 outline-none\">\n                </div>\n                <div>\n                    <label class=\"block text-xs font-bold text-slate-400 mb-1\">PRIORITY</label>\n                    <select id=\"priority\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 outline-none\">\n                        <option>Critical</option>\n                        <option>High</option>\n                        <option>Medium</option>\n                    </select>\n                </div>\n            </div>\n            <div class=\"flex gap-4 mt-6\">\n                <button type=\"button\" onclick=\"toggleModal()\" class=\"flex-1 border border-slate-700 py-3 rounded-lg hover:bg-slate-800\">Cancel</button>\n                <button type=\"submit\" class=\"flex-1 bg-indigo-600 py-3 rounded-lg hover:bg-indigo-500 font-bold\">Submit Action</button>\n            </div>\n        </form>\n    </div>\n</div>\n\n<script>\n    const actions = [\n        { title: \"Finalize Q4 Budget\", owner: \"jane@company.com\", due: \"2023-12-31\", status: \"OPEN\" },\n        { title: \"Security Audit Patch\", owner: \"dev@company.com\", due: \"2023-11-15\", status: \"IN_PROGRESS\" }\n    ];\n\n    const renderTable = () => {\n        const tbody = document.getElementById('actionTable');\n        tbody.innerHTML = actions.map(a => `\n            <tr class=\"hover:bg-slate-800/30 transition-colors\">\n                <td class=\"p-4 font-semibold\">${a.title}</td>\n                <td class=\"p-4 text-slate-400 text-sm\">${a.owner}</td>\n                <td class=\"p-4 text-slate-400 text-sm\">${a.due}</td>\n                <td class=\"p-4\"><span class=\"px-2 py-1 rounded bg-slate-800 text-[10px] font-bold\">${a.status}</span></td>\n                <td class=\"p-4\"><button class=\"text-indigo-400 hover:text-white\"><i class=\"fa-solid fa-chevron-right\"></i></button></td>\n            </tr>\n        `).join('');\n    };\n\n    const toggleModal = () => document.getElementById('modal').classList.toggle('hidden');\n\n    document.getElementById('actionForm').onsubmit = (e) => {\n        e.preventDefault();\n        const newAction = {\n            title: document.getElementById('title').value,\n            owner: document.getElementById('email').value,\n            due: '2023-12-31',\n            status: 'OPEN'\n        };\n        actions.push(newAction);\n        renderTable();\n        toggleModal();\n        alert('API POST /api/v1/actions successful: act-9988');\n    };\n\n    renderTable();\n</script>\n</body>\n</html>"
}