{
  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>VMS | Secure Visitor Management</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: { extend: { colors: { slate: { 950: '#020617' } } } }\n        }\n    </script>\n    <style>\n        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #020617; }\n        .glass { background: rgba(30, 41, 59, 0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); }\n        .glow { box-shadow: 0 0 15px rgba(59, 130, 246, 0.2); }\n    </style>\n</head>\n<body class=\"text-slate-200\">\n\n    <nav class=\"glass fixed w-full top-0 z-50 px-6 py-4 flex justify-between items-center\">\n        <div class=\"flex items-center gap-2\">\n            <div class=\"w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center\"><i class=\"fas fa-shield-halved\"></i></div>\n            <span class=\"font-bold text-lg tracking-tight\">VMS <span class=\"text-blue-500 font-light\">Pro</span></span>\n        </div>\n        <div class=\"flex items-center gap-6 text-sm font-medium\">\n            <span class=\"text-blue-400\">Receptionist Console</span>\n            <div class=\"w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center\"><i class=\"fas fa-user\"></i></div>\n        </div>\n    </nav>\n\n    <main class=\"pt-24 px-6 pb-12 max-w-7xl mx-auto\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n            \n            <!-- Registration Form -->\n            <div class=\"lg:col-span-1 space-y-6\">\n                <div class=\"glass p-6 rounded-2xl\">\n                    <h2 class=\"text-xl font-semibold mb-6 flex items-center gap-2\"><i class=\"fas fa-user-plus text-blue-500\"></i> New Check-In</h2>\n                    <form id=\"checkInForm\" class=\"space-y-4\">\n                        <div>\n                            <label class=\"text-xs text-slate-400 uppercase tracking-wider\">Visitor Name</label>\n                            <input type=\"text\" id=\"vName\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 mt-1 focus:ring-2 focus:ring-blue-500 outline-none transition-all\">\n                        </div>\n                        <div>\n                            <label class=\"text-xs text-slate-400 uppercase tracking-wider\">Mobile Number</label>\n                            <input type=\"tel\" id=\"vMobile\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 mt-1 focus:ring-2 focus:ring-blue-500 outline-none\">\n                        </div>\n                        <div>\n                            <label class=\"text-xs text-slate-400 uppercase tracking-wider\">Employee Host</label>\n                            <select id=\"vEmp\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-3 mt-1 outline-none\">\n                                <option>Sarah Jenkins (Dev)</option>\n                                <option>Mark Ross (Ops)</option>\n                            </select>\n                        </div>\n                        <button type=\"submit\" class=\"w-full bg-blue-600 hover:bg-blue-500 py-3 rounded-lg font-bold transition-all glow\">Process Registration</button>\n                    </form>\n                </div>\n            </div>\n\n            <!-- Visitor Table -->\n            <div class=\"lg:col-span-2 glass rounded-2xl p-6\">\n                <div class=\"flex justify-between items-center mb-6\">\n                    <h2 class=\"text-xl font-semibold\">Active Visitors</h2>\n                    <input type=\"text\" id=\"search\" placeholder=\"Search logs...\" class=\"bg-slate-900 border border-slate-700 rounded-lg px-4 py-2 text-sm outline-none\">\n                </div>\n                <div class=\"overflow-x-auto\">\n                    <table class=\"w-full text-left\">\n                        <thead>\n                            <tr class=\"text-slate-400 text-xs uppercase border-b border-slate-700\">\n                                <th class=\"pb-3\">Name</th>\n                                <th class=\"pb-3\">Host</th>\n                                <th class=\"pb-3\">Check-In</th>\n                                <th class=\"pb-3\">Status</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"visitorTable\" class=\"text-sm\">\n                            <!-- JS Injection -->\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <script>\n        const visitors = [\n            { id: 1, name: 'John Doe', emp: 'Sarah Jenkins', time: '10:45 AM', status: 'Checked-In' },\n            { id: 2, name: 'Alice Smith', emp: 'Mark Ross', time: '09:20 AM', status: 'Checked-In' }\n        ];\n\n        function renderTable() {\n            const container = document.getElementById('visitorTable');\n            container.innerHTML = visitors.map(v => `\n                <tr class=\"border-b border-slate-800 hover:bg-slate-800/50 transition-colors\">\n                    <td class=\"py-4 font-semibold\">${v.name}</td>\n                    <td class=\"py-4 text-slate-400\">${v.emp}</td>\n                    <td class=\"py-4 text-slate-400\">${v.time}</td>\n                    <td class=\"py-4\"><span class=\"px-2 py-1 bg-green-500/10 text-green-400 rounded-full text-xs\">${v.status}</span></td>\n                </tr>\n            `).join('');\n        }\n\n        document.getElementById('checkInForm').addEventListener('submit', (e) => {\n            e.preventDefault();\n            const name = document.getElementById('vName').value;\n            if(!name) return alert('Input required');\n            \n            // Mock API Flow\n            visitors.push({ id: Date.now(), name, emp: 'TBD', time: new Date().toLocaleTimeString(), status: 'Checked-In' });\n            renderTable();\n            e.target.reset();\n            alert('POST /api/visitors/check-in successful. Notification dispatched.');\n        });\n\n        renderTable();\n    </script>\n</body>\n</html>"
}