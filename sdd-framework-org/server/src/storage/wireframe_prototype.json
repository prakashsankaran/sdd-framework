{
  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Project Nexus - Technical Control Center</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    colors: {\n                        slate: {\n                            950: '#020617',\n                            900: '#0f172a',\n                            850: '#090d16',\n                        }\n                    },\n                    fontFamily: {\n                        sans: ['\"Plus Jakarta Sans\"', 'Inter', 'sans-serif'],\n                    }\n                }\n            }\n        }\n    </script>\n    <!-- Google Fonts -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <!-- FontAwesome -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <style>\n        .glass-panel {\n            background: rgba(15, 23, 42, 0.7);\n            backdrop-filter: blur(16px);\n            border: 1px solid rgba(255, 255, 255, 0.08);\n        }\n        .glow-accent {\n            box-shadow: 0 0 25px -5px rgba(59, 130, 246, 0.25);\n        }\n        /* Custom scrollbar */\n        ::-webkit-scrollbar {\n            width: 6px;\n            height: 6px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #020617;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #1e293b;\n            border-radius: 3px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #334155;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col selection:bg-blue-600 selection:text-white\">\n\n    <!-- Top Navigation -->\n    <header class=\"border-b border-slate-800/80 bg-slate-900/50 backdrop-blur-md sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\">\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center glow-accent\">\n                    <i class=\"fa-solid fa-cube text-white text-lg\"></i>\n                </div>\n                <div>\n                    <h1 class=\"font-bold text-base tracking-tight flex items-center gap-2\">\n                        Project Nexus <span class=\"text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20\">Phase 1 & 2 Portal</span>\n                    </h1>\n                    <p class=\"text-xs text-slate-400\">Enterprise Modernization & Self-Service Billing</p>\n                </div>\n            </div>\n\n            <div class=\"flex items-center space-x-4\">\n                <!-- System Health Pill -->\n                <div id=\"system-health-pill\" class=\"flex items-center space-x-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium cursor-pointer hover:bg-emerald-500/20 transition\" onclick=\"switchTab('observability')\">\n                    <span class=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n                    <span id=\"health-pill-text\">All Systems Operational</span>\n                    <i class=\"fa-solid fa-chevron-right text-[10px] ml-1\"></i>\n                </div>\n\n                <!-- User Profile dropdown mock -->\n                <div class=\"flex items-center space-x-3 border-l border-slate-800 pl-4\">\n                    <div class=\"w-9 h-9 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-sm font-bold text-blue-400\">\n                        NX\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Workspace Layout -->\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        \n        <!-- Left Navigation Sidebar -->\n        <aside class=\"lg:col-span-3 space-y-6\">\n            <div class=\"glass-panel rounded-2xl p-4 space-y-1\">\n                <div class=\"px-3 py-2 text-xs font-semibold text-slate-400 uppercase tracking-wider\">Navigation</div>\n                <button onclick=\"switchTab('dashboard')\" id=\"nav-dashboard\" class=\"w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition bg-blue-600 text-white shadow-lg shadow-blue-600/20\">\n                    <i class=\"fa-solid fa-chart-line w-5 text-center\"></i>\n                    <span>Portal & Telemetry</span>\n                </button>\n                <button onclick=\"switchTab('billing')\" id=\"nav-billing\" class=\"w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 transition\">\n                    <i class=\"fa-solid fa-credit-card w-5 text-center\"></i>\n                    <span>Billing & Disputes</span>\n                </button>\n                <button onclick=\"switchTab('observability')\" id=\"nav-observability\" class=\"w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 transition\">\n                    <i class=\"fa-solid fa-server w-5 text-center\"></i>\n                    <span>System Observability</span>\n                </button>\n            </div>\n\n            <!-- Core Metrics Box -->\n            <div class=\"glass-panel rounded-2xl p-5 space-y-4\">\n                <h3 class=\"text-xs font-semibold uppercase tracking-wider text-slate-400 flex items-center justify-between\">\n                    <span>Core Web Vitals</span>\n                    <span class=\"text-emerald-400 text-[10px] bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-500/20\">p95 Target Met</span>\n                </h3>\n                \n                <div class=\"space-y-3\">\n                    <div>\n                        <div class=\"flex justify-between text-xs mb-1\">\n                            <span class=\"text-slate-300\">LCP (Largest Contentful Paint)</span>\n                            <span class=\"text-emerald-400 font-mono font-bold\">1.8s ≤ 2.5s</span>\n                        </div>\n                        <div class=\"w-full bg-slate-800 h-1.5 rounded-full overflow-hidden\">\n                            <div class=\"bg-emerald-500 h-full rounded-full\" style=\"width: 72%\"></div>\n                        </div>\n                    </div>\n                    <div>\n                        <div class=\"flex justify-between text-xs mb-1\">\n                            <span class=\"text-slate-300\">INP (Interaction to Next Paint)</span>\n                            <span class=\"text-emerald-400 font-mono font-bold\">110ms ≤ 200ms</span>\n                        </div>\n                        <div class=\"w-full bg-slate-800 h-1.5 rounded-full overflow-hidden\">\n                            <div class=\"bg-emerald-500 h-full rounded-full\" style=\"width: 55%\"></div>\n                        </div>\n                    </div>\n                    <div>\n                        <div class=\"flex justify-between text-xs mb-1\">\n                            <span class=\"text-slate-300\">CLS (Cumulative Layout Shift)</span>\n                            <span class=\"text-emerald-400 font-mono font-bold\">0.02 ≤ 0.1</span>\n                        </div>\n                        <div class=\"w-full bg-slate-800 h-1.5 rounded-full overflow-hidden\">\n                            <div class=\"bg-emerald-500 h-full rounded-full\" style=\"width: 20%\"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Architecture Quick Info -->\n            <div class=\"glass-panel rounded-2xl p-5 space-y-3 border-l-4 border-l-blue-500\">\n                <div class=\"text-xs font-semibold text-blue-400 uppercase tracking-wider\">Architecture Note</div>\n                <p class=\"text-xs text-slate-300 leading-relaxed\">\n                    PCI compliance is offloaded to managed vendor portal. Binary file uploads bypass app workers via <strong class=\"text-white\">AWS S3 Presigned URLs</strong>.\n                </p>\n            </div>\n        </aside>\n\n        <!-- Main Dynamic Content Area -->\n        <main class=\"lg:col-span-9 space-y-6\">\n\n            <!-- TAB 1: PORTAL & TELEMETRY -->\n            <div id=\"tab-dashboard\" class=\"space-y-6\">\n                <!-- Banner -->\n                <div class=\"glass-panel rounded-2xl p-6 relative overflow-hidden bg-gradient-to-r from-blue-900/20 via-slate-900/40 to-slate-900/80\">\n                    <div class=\"absolute right-0 top-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none\"></div>\n                    <div class=\"relative z-10 max-w-2xl space-y-3\">\n                        <div class=\"inline-flex items-center space-x-2 px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-400 text-xs font-semibold border border-blue-500/20\">\n                            <i class=\"fa-solid fa-shield-halved\"></i>\n                            <span>Phase 1 Retention Focus Active</span>\n                        </div>\n                        <h2 class=\"text-2xl font-bold tracking-tight text-white\">Consumer Portal Modernization</h2>\n                        <p class=\"text-sm text-slate-300 leading-relaxed\">\n                            Engineered for high-speed edge delivery. Real-time telemetry is actively capturing user interaction funnels and session events to combat drop-offs.\n                        </p>\n                        <div class=\"pt-2 flex flex-wrap gap-3\">\n                            <button onclick=\"triggerTelemetryEvent('portal_cta_clicked')\" class=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-xl shadow-lg shadow-blue-600/30 transition flex items-center space-x-2\">\n                                <span class=\"w-2 h-2 rounded-full bg-white animate-ping\"></span>\n                                <span>Simulate Telemetry Event (`POST /events`)</span>\n                            </button>\n                            <button onclick=\"switchTab('billing')\" class=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-semibold rounded-xl border border-slate-700 transition\">\n                                Manage Subscription & Billing\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Telemetry Live Stream Table -->\n                <div class=\"glass-panel rounded-2xl p-6 space-y-4\">\n                    <div class=\"flex items-center justify-between\">\n                        <div>\n                            <h3 class=\"text-lg font-bold text-white\">Real User Telemetry & Funnel Ingest</h3>\n                            <p class=\"text-xs text-slate-400\">Live events captured via <code class=\"text-blue-400\">POST /api/v1/telemetry/events</code></p>\n                        </div>\n                        <button onclick=\"clearTelemetryLog()\" class=\"text-xs text-slate-400 hover:text-slate-200 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700 transition\">\n                            Clear Feed\n                        </button>\n                    </div>\n\n                    <div class=\"overflow-x-auto\">\n                        <table class=\"w-full text-left text-sm text-slate-300\">\n                            <thead class=\"bg-slate-900/60 text-xs uppercase text-slate-400 font-semibold border-b border-slate-800\">\n                                <tr>\n                                    <th class=\"px-4 py-3\">Timestamp</th>\n                                    <th class=\"px-4 py-3\">Event Action</th>\n                                    <th class=\"px-4 py-3\">Session ID</th>\n                                    <th class=\"px-4 py-3\">Device / Geo</th>\n                                    <th class=\"px-4 py-3 text-right\">Status</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"telemetry-table-body\" class=\"divide-y divide-slate-800/60 font-mono text-xs\">\n                                <!-- Dynamic rows injected via JS -->\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n            </div>\n\n            <!-- TAB 2: BILLING & DISPUTES -->\n            <div id=\"tab-billing\" class=\"space-y-6 hidden\">\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                    <!-- Managed Portal Card -->\n                    <div class=\"glass-panel rounded-2xl p-6 space-y-4 relative border-blue-500/30\">\n                        <div class=\"absolute top-4 right-4\">\n                            <span class=\"px-2 py-1 rounded bg-blue-500/10 text-blue-400 text-[10px] font-bold border border-blue-500/20\">Mandated Default</span>\n                        </div>\n                        <div class=\"w-12 h-12 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center text-xl\">\n                            <i class=\"fa-solid fa-credit-card\"></i>\n                        </div>\n                        <div>\n                            <h3 class=\"text-base font-bold text-white\">Managed Customer Portal</h3>\n                            <p class=\"text-xs text-slate-400 mt-1\">Stripe / Braintree Hosted Portal</p>\n                        </div>\n                        <p class=\"text-xs text-slate-300 leading-relaxed\">\n                            Zero PCI-DSS scope overhead. Handles payment tokenization, update workflows, and automated invoice PDF generation.\n                        </p>\n                        <button onclick=\"openManagedPortalModal()\" class=\"w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl text-xs shadow-lg shadow-blue-600/20 transition flex items-center justify-center space-x-2\">\n                            <span>Launch Secure Portal SSO</span>\n                            <i class=\"fa-solid fa-external-link text-[10px]\"></i>\n                        </button>\n                    </div>\n\n                    <!-- Custom Billing Fallback Scope -->\n                    <div class=\"glass-panel rounded-2xl p-6 space-y-4 md:col-span-2 flex flex-col justify-between\">\n                        <div>\n                            <div class=\"flex items-center justify-between mb-2\">\n                                <h3 class=\"text-base font-bold text-white\">Custom Billing Fallback Rules & MVP Scope</h3>\n                                <span class=\"text-xs text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20 font-mono\">Strict Caching Guardrails Active</span>\n                            </div>\n                            <p class=\"text-xs text-slate-300\">\n                                If custom interface is required, scope is strictly capped at three capabilities: <strong class=\"text-white\">1. View Billing History</strong>, <strong class=\"text-white\">2. Update Payment Method</strong>, and <strong class=\"text-white\">3. Cancel/Pause Subscription</strong>.\n                            </p>\n                        </div>\n\n                        <div class=\"grid grid-cols-3 gap-3 pt-2\">\n                            <div class=\"bg-slate-900/60 p-3 rounded-xl border border-slate-800 text-center\">\n                                <div class=\"text-emerald-400 font-bold text-sm\">Active</div>\n                                <div class=\"text-[10px] text-slate-400 mt-0.5\">Billing History</div>\n                            </div>\n                            <div class=\"bg-slate-900/60 p-3 rounded-xl border border-slate-800 text-center\">\n                                <div class=\"text-emerald-400 font-bold text-sm\">Configured</div>\n                                <div class=\"text-[10px] text-slate-400 mt-0.5\">Payment Method</div>\n                            </div>\n                            <div class=\"bg-slate-900/60 p-3 rounded-xl border border-slate-800 text-center\">\n                                <div class=\"text-emerald-400 font-bold text-sm\">Protected</div>\n                                <div class=\"text-[10px] text-slate-400 mt-0.5\">CDC Cache Guard</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Async Dispute Submission Form (Matching Spec Section 3.1) -->\n                <div class=\"glass-panel rounded-2xl p-6 space-y-6\">\n                    <div>\n                        <h3 class=\"text-lg font-bold text-white\">Submit Billing Dispute (Async Worker Pipeline)</h3>\n                        <p class=\"text-xs text-slate-400\">Demonstrates Direct-to-S3 presigned URL upload & Asynchronous SQS Queue job processing.</p>\n                    </div>\n\n                    <form id=\"dispute-form\" onsubmit=\"handleDisputeSubmission(event)\" class=\"space-y-4\">\n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                            <div>\n                                <label class=\"block text-xs font-semibold text-slate-300 mb-1\">Dispute Reason</label>\n                                <select id=\"dispute-reason\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500\">\n                                    <option value=\"incorrect_charge\">incorrect_charge</option>\n                                    <option value=\"duplicate_billing\">duplicate_billing</option>\n                                    <option value=\"unrecognized_transaction\">unrecognized_transaction</option>\n                                    <option value=\"service_failure\">service_failure</option>\n                                </select>\n                            </div>\n                            <div>\n                                <label class=\"block text-xs font-semibold text-slate-300 mb-1\">Evidence Document (PDF/Receipt)</label>\n                                <input type=\"file\" id=\"dispute-file\" required class=\"w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-300 file:mr-4 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-500\">\n                            </div>\n                        </div>\n\n                        <div class=\"flex justify-end\">\n                            <button type=\"submit\" id=\"submit-dispute-btn\" class=\"px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm rounded-xl shadow-lg shadow-blue-600/30 transition flex items-center space-x-2\">\n                                <i class=\"fa-solid fa-cloud-arrow-up\"></i>\n                                <span>Request Presigned URL & Dispatch Job</span>\n                            </button>\n                        </div>\n                    </form>\n\n                    <!-- Active Jobs / Async Status Tracker -->\n                    <div id=\"async-jobs-container\" class=\"mt-6 pt-6 border-t border-slate-800 space-y-3 hidden\">\n                        <h4 class=\"text-xs font-semibold uppercase tracking-wider text-slate-400\">Asynchronous Job Pipeline Status</h4>\n                        <div id=\"job-status-card\" class=\"bg-slate-900/80 border border-slate-800 rounded-xl p-4 flex items-center justify-between\">\n                            <div class=\"space-y-1\">\n                                <div class=\"flex items-center space-x-2\">\n                                    <span id=\"job-id-display\" class=\"font-mono text-xs text-blue-400 font-bold\">job-77123-abc</span>\n                                    <span id=\"job-status-badge\" class=\"px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-bold\">QUEUED</span>\n                                </div>\n                                <p id=\"job-status-desc\" class=\"text-xs text-slate-400\">File uploaded via AWS S3 Presigned URL. Dispatched to SQS Worker Pool.</p>\n                            </div>\n                            <button id=\"poll-job-btn\" onclick=\"pollJobStatus()\" class=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 rounded-lg border border-slate-700 transition\">\n                                Poll Status Endpoint\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- TAB 3: SYSTEM OBSERVABILITY & HEALTH -->\n            <div id=\"tab-observability\" class=\"space-y-6 hidden\">\n                <div class=\"glass-panel rounded-2xl p-6 space-y-6\">\n                    <div class=\"flex items-center justify-between\">\n                        <div>\n                            <h3 class=\"text-lg font-bold text-white\">System Observability & Health Probes</h3>\n                            <p class=\"text-xs text-slate-400\">Endpoints: <code class=\"text-blue-400\">/healthz/live</code> & <code class=\"text-blue-400\">/healthz/ready</code></p>\n                        </div>\n                        <button onclick=\"runHealthCheck()\" class=\"px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl shadow transition flex items-center space-x-2\">\n                            <i class=\"fa-solid fa-rotate\"></i>\n                            <span>Run Probes Now</span>\n                        </button>\n                    </div>\n\n                    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                        <!-- Database Check -->\n                        <div class=\"bg-slate-900/60 p-4 rounded-xl border border-slate-800 space-y-2\">\n                            <div class=\"flex items-center justify-between\">\n                                <span class=\"text-xs text-slate-400 font-medium\">Database (RLS / Conn)</span>\n                                <span id=\"check-db\" class=\"w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse\"></span>\n                            </div>\n                            <div class=\"text-sm font-bold text-white\">UP</div>\n                            <p class=\"text-[10px] text-slate-500\">Row-Level Security active & pre-filtered.</p>\n                        </div>\n\n                        <!-- Queue Lag Check -->\n                        <div class=\"bg-slate-900/60 p-4 rounded-xl border border-slate-800 space-y-2\">\n                            <div class=\"flex items-center justify-between\">\n                                <span class=\"text-xs text-slate-400 font-medium\">SQS Queue Depth / Lag</span>\n                                <span id=\"check-queue\" class=\"w-2.5 h-2.5 rounded-full bg-emerald-400\"></span>\n                            </div>\n                            <div class=\"text-sm font-bold text-white\">OK (0 msgs lag)</div>\n                            <p class=\"text-[10px] text-slate-500\">Asynchronous background worker pool healthy.</p>\n                        </div>\n\n                        <!-- Billing Portal Check -->\n                        <div class=\"bg-slate-900/60 p-4 rounded-xl border border-slate-800 space-y-2\">\n                            <div class=\"flex items-center justify-between\">\n                                <span class=\"text-xs text-slate-400 font-medium\">Managed Billing Portal</span>\n                                <span id=\"check-billing\" class=\"w-2.5 h-2.5 rounded-full bg-emerald-400\"></span>\n                            </div>\n                            <div class=\"text-sm font-bold text-white\">UP</div>\n                            <p class=\"text-[10px] text-slate-500\">PCI compliance scope fully offloaded.</p>\n                        </div>\n                    </div>\n\n                    <!-- Raw JSON Health Payload Output -->\n                    <div class=\"space-y-2\">\n                        <div class=\"text-xs font-semibold text-slate-400\">Live JSON Response (`GET /healthz/ready`)</div>\n                        <pre id=\"health-json-output\" class=\"bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs font-mono text-emerald-400 overflow-x-auto\">{\n  \"status\": \"READY\",\n  \"checks\": {\n    \"database\": \"UP\",\n    \"queueLag\": \"OK\",\n    \"billingPortal\": \"UP\"\n  }\n}</pre>\n                    </div>\n                </div>\n            </div>\n\n        </main>\n    </div>\n\n    <!-- Managed Portal SSO Simulated Modal -->\n    <div id=\"managed-portal-modal\" class=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden\">\n        <div class=\"glass-panel max-w-lg w-full rounded-2xl p-6 space-y-6 border border-slate-700 shadow-2xl relative\">\n            <button onclick=\"closeManagedPortalModal()\" class=\"absolute top-4 right-4 text-slate-400 hover:text-white\">\n                <i class=\"fa-solid fa-xmark text-lg\"></i>\n            </button>\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center\">\n                    <i class=\"fa-solid fa-lock text-lg\"></i>\n                </div>\n                <div>\n                    <h3 class=\"text-base font-bold text-white\">Managed Customer Portal SSO Redirect</h3>\n                    <p class=\"text-xs text-slate-400\">PCI-DSS Scope Elimination Guardrail</p>\n                </div>\n            </div>\n            <div class=\"bg-slate-900/80 p-4 rounded-xl border border-slate-800 text-xs space-y-2 text-slate-300\">\n                <p>You are securely exchanging session tokens to open the managed vendor billing portal (Stripe Customer Portal frame).</p>\n                <p class=\"text-slate-400 font-mono\">Token Expiry: 300s | Secure SSO Hash Verified</p>\n            </div>\n            <div class=\"flex justify-end space-x-3\">\n                <button onclick=\"closeManagedPortalModal()\" class=\"px-4 py-2 rounded-xl bg-slate-800 text-slate-300 text-xs font-semibold hover:bg-slate-700 transition\">Cancel</button>\n                <button onclick=\"confirmManagedPortalRedirect()\" class=\"px-4 py-2 rounded-xl bg-blue-600 text-white text-xs font-semibold hover:bg-blue-500 shadow-lg shadow-blue-600/30 transition\">Proceed to Secure Portal</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Footer -->\n    <footer class=\"border-t border-slate-800/80 bg-slate-900/30 py-6 mt-auto\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4\">\n            <div>Project Nexus Technical Specification Mockup &bull; Edge CDN Architecture</div>\n            <div class=\"flex items-center space-x-4\">\n                <span>LCP &le; 2.5s</span>\n                <span>&bull;</span>\n                <span>INP &le; 200ms</span>\n                <span>&bull;</span>\n                <span>PCI-DSS Scope Offloaded</span>\n            </div>\n        </div>\n    </footer>\n\n    <!-- Interactive JavaScript Engine -->\n    <script>\n        // Tab switching logic\n        function switchTab(tabId) {\n            ['dashboard', 'billing', 'observability'].forEach(t => {\n                const el = document.getElementById(`tab-${t}`);\n                const nav = document.getElementById(`nav-${t}`);\n                if (t === tabId) {\n                    el.classList.remove('hidden');\n                    nav.className = \"w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition bg-blue-600 text-white shadow-lg shadow-blue-600/20\";\n                } else {\n                    el.classList.add('hidden');\n                    nav.className = \"w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 transition\";\n                }\n            });\n        }\n\n        // Telemetry simulated feed mock data\n        let telemetryEvents = [\n            { timestamp: new Date(Date.now() - 120000).toISOString(), action: 'page_view: /portal/dashboard', sessionId: 'sess_99182a', device: 'Desktop / US-East', status: '204 No Content' },\n            { timestamp: new Date(Date.now() - 90000).toISOString(), action: 'interaction: subscription_tab_click', sessionId: 'sess_99182a', device: 'Desktop / US-East', status: '204 No Content' },\n            { timestamp: new Date(Date.now() - 45000).toISOString(), action: 'funnel_step: dispute_form_init', sessionId: 'sess_88310b', device: 'Mobile / EU-West', status: '204 No Content' },\n            { timestamp: new Date(Date.now() - 10000).toISOString(), action: 'telemetry: heartbeat_ping', sessionId: 'sess_88310b', device: 'Mobile / EU-West', status: '204 No Content' }\n        ];\n\n        function renderTelemetryTable() {\n            const tbody = document.getElementById('telemetry-table-body');\n            tbody.innerHTML = telemetryEvents.map(ev => `\n                <tr class=\"hover:bg-slate-900/40 transition\">\n                    <td class=\"px-4 py-3 text-slate-400\">${ev.timestamp.split('T')[1].slice(0, 8)}</td>\n                    <td class=\"px-4 py-3 text-blue-400 font-bold\">${ev.action}</td>\n                    <td class=\"px-4 py-3 text-slate-300\">${ev.sessionId}</td>\n                    <td class=\"px-4 py-3 text-slate-400\">${ev.device}</td>\n                    <td class=\"px-4 py-3 text-right\"><span class=\"px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]\">${ev.status}</span></td>\n                </tr>\n            `).join('');\n        }\n\n        function triggerTelemetryEvent(actionName) {\n            const newEvent = {\n                timestamp: new Date().toISOString(),\n                action: `user_action: ${actionName}`,\n                sessionId: 'sess_' + Math.random().toString(36).substring(2, 8),\n                device: 'Desktop / Edge-CDN',\n                status: '204 No Content'\n            };\n            telemetryEvents.unshift(newEvent);\n            renderTelemetryTable();\n        }\n\n        function clearTelemetryLog() {\n            telemetryEvents = [];\n            renderTelemetryTable();\n        }\n\n        // Dispute form submission & async job lifecycle simulation\n        let currentJobStatus = 'QUEUED';\n\n        function handleDisputeSubmission(e) {\n            e.preventDefault();\n            const btn = document.getElementById('submit-dispute-btn');\n            btn.disabled = true;\n            btn.innerHTML = `<i class=\"fa-solid fa-spinner animate-spin\"></i><span>Requesting Presigned URL...</span>`;\n\n            setTimeout(() => {\n                btn.disabled = false;\n                btn.innerHTML = `<i class=\"fa-solid fa-cloud-arrow-up\"></i><span>Request Presigned URL & Dispatch Job</span>`;\n                \n                // Reveal container\n                document.getElementById('async-jobs-container').classList.remove('hidden');\n                currentJobStatus = 'QUEUED';\n                updateJobCardState();\n                \n                alert(\"Success: Presigned URL generated, binary uploaded directly to S3, and async job dispatched to SQS with 202 Accepted!\");\n            }, 1000);\n        }\n\n        function updateJobCardState() {\n            const badge = document.getElementById('job-status-badge');\n            const desc = document.getElementById('job-status-desc');\n            \n            if (currentJobStatus === 'QUEUED') {\n                badge.className = \"px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-bold\";\n                badge.innerText = \"QUEUED\";\n                desc.innerText = \"File uploaded via AWS S3 Presigned URL. Dispatched to SQS Worker Pool.\";\n            } else if (currentJobStatus === 'PROCESSING') {\n                badge.className = \"px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-bold\";\n                badge.innerText = \"PROCESSING\";\n                desc.innerText = \"Background worker pool parsing evidentiary PDF document out-of-band.\";\n            } else if (currentJobStatus === 'COMPLETED') {\n                badge.className = \"px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold\";\n                badge.innerText = \"COMPLETED\";\n                desc.innerText = \"Job successfully completed. Dispute evidence registered in database.\";\n            }\n        }\n\n        function pollJobStatus() {\n            const pollBtn = document.getElementById('poll-job-btn');\n            pollBtn.innerText = \"Polling...\";\n            \n            setTimeout(() => {\n                if (currentJobStatus === 'QUEUED') currentJobStatus = 'PROCESSING';\n                else if (currentJobStatus === 'PROCESSING') currentJobStatus = 'COMPLETED';\n                else currentJobStatus = 'COMPLETED';\n                \n                updateJobCardState();\n                pollBtn.innerText = \"Poll Status Endpoint\";\n            }, 600);\n        }\n\n        // Managed portal modal control\n        function openManagedPortalModal() {\n            document.getElementById('managed-portal-modal').classList.remove('hidden');\n        }\n\n        function closeManagedPortalModal() {\n            document.getElementById('managed-portal-modal').classList.add('hidden');\n        }\n\n        function confirmManagedPortalRedirect() {\n            closeManagedPortalModal();\n            alert(\"Redirecting securely to Stripe / Braintree Customer Portal via SSO token exchange...\");\n        }\n\n        // Health check simulation\n        function runHealthCheck() {\n            const output = document.getElementById('health-json-output');\n            output.innerText = `Checking dependencies...`;\n            setTimeout(() => {\n                output.innerText = JSON.stringify({\n                    \"status\": \"READY\",\n                    \"checks\": {\n                        \"database\": \"UP\",\n                        \"queueLag\": \"OK (0 msgs)\",\n                        \"billingPortal\": \"UP\"\n                    },\n                    \"timestamp\": new Date().toISOString()\n                }, null, 2);\n            }, 400);\n        }\n\n        // Initialize on load\n        window.onload = function() {\n            renderTelemetryTable();\n        };\n    </script>\n</body>\n</html>"
}