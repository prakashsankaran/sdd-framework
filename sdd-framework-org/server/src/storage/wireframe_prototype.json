{
  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>MEETING MANAGER - Enterprise Suite</title>\n    <!-- Tailwind CSS -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    colors: {\n                        slate: {\n                            950: '#020617',\n                        },\n                        brand: {\n                            500: '#6366f1',\n                            600: '#4f46e5',\n                            400: '#818cf8'\n                        }\n                    },\n                    fontFamily: {\n                        sans: ['\"Plus Jakarta Sans\"', 'sans-serif'],\n                    }\n                }\n            }\n        }\n    </script>\n    <!-- Google Fonts -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <!-- Font Awesome -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <style>\n        .glass {\n            background: rgba(15, 23, 42, 0.75);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.08);\n        }\n        .glass-card {\n            background: rgba(30, 41, 59, 0.5);\n            backdrop-filter: blur(8px);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n        /* Custom scrollbar */\n        ::-webkit-scrollbar {\n            width: 6px;\n            height: 6px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #020617;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #1e293b;\n            border-radius: 3px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #334155;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-500 selection:text-white\">\n\n    <!-- Top Navigation Bar -->\n    <header class=\"h-16 border-b border-slate-800/80 glass sticky top-0 z-40 px-6 flex items-center justify-between\">\n        <div class=\"flex items-center space-x-4\">\n            <div class=\"h-10 w-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-400 flex items-center justify-center shadow-lg shadow-brand-500/20\">\n                <i class=\"fa-solid fa-handshake-angle text-white text-lg\"></i>\n            </div>\n            <div>\n                <h1 class=\"font-bold text-lg tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent\">MEETING MANAGER</h1>\n                <p class=\"text-xs text-slate-400 flex items-center gap-1.5\"><span class=\"h-2 w-2 rounded-full bg-emerald-500 animate-pulse\"></span> API: /api/v1/meetings</p>\n            </div>\n        </div>\n\n        <div class=\"flex items-center space-x-4\">\n            <div class=\"relative hidden md:block\">\n                <i class=\"fa-solid fa-search absolute left-3.5 top-3 text-slate-400 text-sm\"></i>\n                <input type=\"text\" id=\"globalSearch\" placeholder=\"Search meetings, agendas...\" class=\"bg-slate-900/80 border border-slate-800 rounded-xl pl-10 pr-4 py-2 text-sm focus:outline-none focus:border-brand-500 transition-all w-64 placeholder:text-slate-500 text-slate-200\">\n            </div>\n\n            <button onclick=\"openModal()\" class=\"bg-brand-600 hover:bg-brand-500 text-white px-4 py-2 rounded-xl font-medium text-sm transition-all shadow-lg shadow-brand-600/30 flex items-center gap-2 active:scale-95\">\n                <i class=\"fa-solid fa-plus text-xs\"></i> New Meeting\n            </button>\n\n            <div class=\"h-6 w-[1px] bg-slate-800\"></div>\n\n            <div class=\"flex items-center space-x-3\">\n                <div class=\"h-9 w-9 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-sm font-semibold text-brand-400\">\n                    AD\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Layout Container -->\n    <div class=\"flex-1 flex overflow-hidden\">\n\n        <!-- Sidebar Navigation -->\n        <aside class=\"w-64 border-r border-slate-800/80 bg-slate-950/50 hidden lg:flex flex-col justify-between p-4\">\n            <div class=\"space-y-6\">\n                <div>\n                    <p class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 mb-2\">Overview</p>\n                    <nav class=\"space-y-1\">\n                        <a href=\"#\" onclick=\"filterView('all', this)\" class=\"sidebar-link flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium bg-brand-600/10 text-brand-400 border border-brand-500/20 transition-all\">\n                            <i class=\"fa-solid fa-chart-pie w-5\"></i>\n                            <span>Dashboard</span>\n                        </a>\n                        <a href=\"#\" onclick=\"filterView('upcoming', this)\" class=\"sidebar-link flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-900 transition-all\">\n                            <i class=\"fa-solid fa-calendar-days w-5\"></i>\n                            <span>Upcoming Sessions</span>\n                        </a>\n                        <a href=\"#\" onclick=\"filterView('completed', this)\" class=\"sidebar-link flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-900 transition-all\">\n                            <i class=\"fa-solid fa-circle-check w-5\"></i>\n                            <span>Archived & Notes</span>\n                        </a>\n                    </nav>\n                </div>\n\n                <div>\n                    <p class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider px-3 mb-2\">Categories</p>\n                    <div class=\"space-y-1\">\n                        <a href=\"#\" onclick=\"filterCategory('Engineering', this)\" class=\"category-link flex items-center justify-between px-3 py-2 rounded-lg text-sm text-slate-400 hover:bg-slate-900 transition-all\">\n                            <span class=\"flex items-center gap-2\"><i class=\"fa-solid fa-code text-indigo-400 text-xs\"></i> Engineering</span>\n                            <span class=\"text-xs bg-slate-800 px-2 py-0.5 rounded-md text-slate-400\">3</span>\n                        </a>\n                        <a href=\"#\" onclick=\"filterCategory('Product', this)\" class=\"category-link flex items-center justify-between px-3 py-2 rounded-lg text-sm text-slate-400 hover:bg-slate-900 transition-all\">\n                            <span class=\"flex items-center gap-2\"><i class=\"fa-solid fa-layer-group text-sky-400 text-xs\"></i> Product</span>\n                            <span class=\"text-xs bg-slate-800 px-2 py-0.5 rounded-md text-slate-400\">2</span>\n                        </a>\n                        <a href=\"#\" onclick=\"filterCategory('Executive', this)\" class=\"category-link flex items-center justify-between px-3 py-2 rounded-lg text-sm text-slate-400 hover:bg-slate-900 transition-all\">\n                            <span class=\"flex items-center gap-2\"><i class=\"fa-solid fa-chess text-emerald-400 text-xs\"></i> Executive</span>\n                            <span class=\"text-xs bg-slate-800 px-2 py-0.5 rounded-md text-slate-400\">1</span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Storage/System status widget -->\n            <div class=\"p-3 rounded-2xl glass-card space-y-2\">\n                <div class=\"flex justify-between text-xs font-medium text-slate-400\">\n                    <span>Database Status</span>\n                    <span class=\"text-emerald-400\">Synced</span>\n                </div>\n                <div class=\"w-full bg-slate-800 h-1.5 rounded-full overflow-hidden\">\n                    <div class=\"bg-brand-500 h-full w-3/4 rounded-full\"></div>\n                </div>\n                <p class=\"text-[10px] text-slate-500\">POST /api/v1/meetings active</p>\n            </div>\n        </aside>\n\n        <!-- Main Content Wrapper -->\n        <main class=\"flex-1 flex flex-col overflow-y-auto bg-slate-950 p-6 lg:p-8\">\n\n            <!-- Metrics / KPI Cards -->\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">\n                <div class=\"glass-card p-5 rounded-2xl relative overflow-hidden group hover:border-slate-700 transition-all\">\n                    <div class=\"flex items-center justify-between\">\n                        <div>\n                            <p class=\"text-xs font-medium text-slate-400\">Total Sessions</p>\n                            <h3 class=\"text-2xl font-bold mt-1 text-slate-100\" id=\"totalCount\">6</h3>\n                        </div>\n                        <div class=\"h-10 w-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center border border-indigo-500/20\">\n                            <i class=\"fa-solid fa-calendar-check\"></i>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-center text-xs text-emerald-400 gap-1 font-medium\">\n                        <i class=\"fa-solid fa-arrow-trend-up\"></i> +12% from last week\n                    </div>\n                </div>\n\n                <div class=\"glass-card p-5 rounded-2xl relative overflow-hidden group hover:border-slate-700 transition-all\">\n                    <div class=\"flex items-center justify-between\">\n                        <div>\n                            <p class=\"text-xs font-medium text-slate-400\">Upcoming Today</p>\n                            <h3 class=\"text-2xl font-bold mt-1 text-slate-100\" id=\"todayCount\">2</h3>\n                        </div>\n                        <div class=\"h-10 w-10 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center border border-sky-500/20\">\n                            <i class=\"fa-solid fa-clock\"></i>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-center text-xs text-sky-400 gap-1 font-medium\">\n                        <i class=\"fa-solid fa-bolt\"></i> Next in 45 mins\n                    </div>\n                </div>\n\n                <div class=\"glass-card p-5 rounded-2xl relative overflow-hidden group hover:border-slate-700 transition-all\">\n                    <div class=\"flex items-center justify-between\">\n                        <div>\n                            <p class=\"text-xs font-medium text-slate-400\">Action Items Open</p>\n                            <h3 class=\"text-2xl font-bold mt-1 text-slate-100\">14</h3>\n                        </div>\n                        <div class=\"h-10 w-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center border border-amber-500/20\">\n                            <i class=\"fa-solid fa-list-check\"></i>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-center text-xs text-amber-400 gap-1 font-medium\">\n                        <i class=\"fa-solid fa-triangle-exclamation\"></i> 3 due today\n                    </div>\n                </div>\n\n                <div class=\"glass-card p-5 rounded-2xl relative overflow-hidden group hover:border-slate-700 transition-all\">\n                    <div class=\"flex items-center justify-between\">\n                        <div>\n                            <p class=\"text-xs font-medium text-slate-400\">Total Hours Logged</p>\n                            <h3 class=\"text-2xl font-bold mt-1 text-slate-100\">24.5 hrs</h3>\n                        </div>\n                        <div class=\"h-10 w-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center border border-emerald-500/20\">\n                            <i class=\"fa-solid fa-chart-line\"></i>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex items-center text-xs text-slate-400 gap-1 font-medium\">\n                        Optimized scheduling efficiency\n                    </div>\n                </div>\n            </div>\n\n            <!-- Table Controls / Filter bar -->\n            <div class=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-6\">\n                <div class=\"flex items-center space-x-2 overflow-x-auto pb-2 sm:pb-0\">\n                    <button onclick=\"switchTab('all', this)\" class=\"tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-brand-600 text-white shadow-md transition-all whitespace-nowrap\">All Meetings</button>\n                    <button onclick=\"switchTab('upcoming', this)\" class=\"tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 transition-all whitespace-nowrap\">Upcoming</button>\n                    <button onclick=\"switchTab('completed', this)\" class=\"tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 transition-all whitespace-nowrap\">Completed</button>\n                </div>\n\n                <div class=\"flex items-center space-x-3\">\n                    <select id=\"categoryFilter\" onchange=\"applyFilters()\" class=\"bg-slate-900 border border-slate-800 rounded-xl px-3 py-2 text-xs font-medium text-slate-300 focus:outline-none focus:border-brand-500\">\n                        <option value=\"\">All Categories</option>\n                        <option value=\"Engineering\">Engineering</option>\n                        <option value=\"Product\">Product</option>\n                        <option value=\"Executive\">Executive</option>\n                    </select>\n                    <button onclick=\"renderMeetings()\" class=\"bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 px-3 py-2 rounded-xl text-xs font-medium transition-all flex items-center gap-2\">\n                        <i class=\"fa-solid fa-rotate\"></i> Refresh\n                    </button>\n                </div>\n            </div>\n\n            <!-- Meeting Data Table -->\n            <div class=\"glass-card rounded-2xl overflow-hidden border border-slate-800/80 shadow-2xl flex-1 flex flex-col\">\n                <div class=\"overflow-x-auto flex-1\">\n                    <table class=\"w-full text-left border-collapse\">\n                        <thead>\n                            <tr class=\"border-b border-slate-800 bg-slate-900/50 text-[11px] font-semibold text-slate-400 uppercase tracking-wider\">\n                                <th class=\"py-3.5 px-6\">Meeting Title</th>\n                                <th class=\"py-3.5 px-6\">Category</th>\n                                <th class=\"py-3.5 px-6\">Organizer</th>\n                                <th class=\"py-3.5 px-6\">Date & Time</th>\n                                <th class=\"py-3.5 px-6\">Status</th>\n                                <th class=\"py-3.5 px-6 text-right\">Actions</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"meetingsTableBody\" class=\"divide-y divide-slate-800/60 text-sm\">\n                            <!-- Populated dynamically via script -->\n                        </tbody>\n                    </table>\n                </div>\n\n                <!-- Pagination footer -->\n                <div class=\"p-4 border-t border-slate-800 bg-slate-900/30 flex items-center justify-between text-xs text-slate-400\">\n                    <div id=\"tableCounter\">Showing 1 to 6 of 6 entries</div>\n                    <div class=\"flex items-center space-x-2\">\n                        <button class=\"px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:bg-slate-700 disabled:opacity-50\" disabled>Previous</button>\n                        <button class=\"px-3 py-1.5 rounded-lg bg-brand-600 text-white font-medium\">1</button>\n                        <button class=\"px-3 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:bg-slate-700\">Next</button>\n                    </div>\n                </div>\n            </div>\n\n        </main>\n    </div>\n\n    <!-- Create/Edit Meeting Modal -->\n    <div id=\"meetingModal\" class=\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4\">\n        <div class=\"glass-card w-full max-w-lg rounded-3xl border border-slate-700 shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-200\">\n            <div class=\"px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-900/60\">\n                <div class=\"flex items-center space-x-3\">\n                    <div class=\"h-8 w-8 rounded-lg bg-brand-600/20 text-brand-400 flex items-center justify-center\">\n                        <i class=\"fa-solid fa-calendar-plus\"></i>\n                    </div>\n                    <h3 id=\"modalTitle\" class=\"font-bold text-base text-slate-100\">Schedule New Meeting</h3>\n                </div>\n                <button onclick=\"closeModal()\" class=\"text-slate-400 hover:text-slate-200 h-8 w-8 rounded-lg flex items-center justify-center hover:bg-slate-800 transition-all\">\n                    <i class=\"fa-solid fa-xmark\"></i>\n                </button>\n            </div>\n\n            <form id=\"meetingForm\" onsubmit=\"handleFormSubmit(event)\" class=\"p-6 space-y-4\">\n                <input type=\"hidden\" id=\"meetingId\">\n                \n                <div>\n                    <label class=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">Meeting Title</label>\n                    <input type=\"text\" id=\"title\" required placeholder=\"e.g. Q3 Architecture Review\" class=\"w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-brand-500 transition-all\">\n                </div>\n\n                <div class=\"grid grid-cols-2 gap-4\">\n                    <div>\n                        <label class=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">Category</label>\n                        <select id=\"category\" class=\"w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-brand-500 transition-all\">\n                            <option value=\"Engineering\">Engineering</option>\n                            <option value=\"Product\">Product</option>\n                            <option value=\"Executive\">Executive</option>\n                        </select>\n                    </div>\n                    <div>\n                        <label class=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">Organizer</label>\n                        <input type=\"text\" id=\"organizer\" required placeholder=\"e.g. Alex Mercer\" class=\"w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-brand-500 transition-all\">\n                    </div>\n                </div>\n\n                <div class=\"grid grid-cols-2 gap-4\">\n                    <div>\n                        <label class=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">Date & Time</label>\n                        <input type=\"datetime-local\" id=\"datetime\" required class=\"w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-brand-500 transition-all\">\n                    </div>\n                    <div>\n                        <label class=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">Status</label>\n                        <select id=\"status\" class=\"w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-brand-500 transition-all\">\n                            <option value=\"upcoming\">Upcoming</option>\n                            <option value=\"completed\">Completed</option>\n                        </select>\n                    </div>\n                </div>\n\n                <div>\n                    <label class=\"block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5\">Agenda / Notes</label>\n                    <textarea id=\"agenda\" rows=\"3\" placeholder=\"Outline primary meeting objectives...\" class=\"w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-brand-500 transition-all\"></textarea>\n                </div>\n\n                <div class=\"pt-4 border-t border-slate-800 flex items-center justify-end space-x-3\">\n                    <button type=\"button\" onclick=\"closeModal()\" class=\"px-4 py-2 rounded-xl border border-slate-800 text-slate-300 text-xs font-medium hover:bg-slate-900 transition-all\">Cancel</button>\n                    <button type=\"submit\" class=\"px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-medium shadow-lg shadow-brand-600/30 transition-all\">Save Meeting</button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <!-- Slide-over Details Drawer -->\n    <div id=\"detailsDrawer\" class=\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex justify-end\">\n        <div class=\"glass-card w-full max-w-md h-full border-l border-slate-700 shadow-2xl flex flex-col animate-in slide-in-from-right duration-200 bg-slate-950\">\n            <div class=\"px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-900/60\">\n                <div class=\"flex items-center space-x-3\">\n                    <div class=\"h-8 w-8 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center\">\n                        <i class=\"fa-solid fa-circle-info\"></i>\n                    </div>\n                    <h3 class=\"font-bold text-base text-slate-100\">Meeting Details</h3>\n                </div>\n                <button onclick=\"closeDetails()\" class=\"text-slate-400 hover:text-slate-200 h-8 w-8 rounded-lg flex items-center justify-center hover:bg-slate-800 transition-all\">\n                    <i class=\"fa-solid fa-xmark\"></i>\n                </button>\n            </div>\n\n            <div id=\"drawerContent\" class=\"p-6 space-y-6 overflow-y-auto flex-1\">\n                <!-- Injected via JS -->\n            </div>\n\n            <div class=\"p-4 border-t border-slate-800 bg-slate-900/30 flex items-center justify-between\">\n                <button onclick=\"deleteMeetingFromDrawer()\" class=\"text-rose-400 hover:text-rose-300 text-xs font-medium flex items-center gap-1.5 px-3 py-2 rounded-lg hover:bg-rose-500/10 transition-all\">\n                    <i class=\"fa-solid fa-trash\"></i> Delete Meeting\n                </button>\n                <button onclick=\"closeDetails()\" class=\"px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-medium transition-all\">Close</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Notification Toast Container -->\n    <div id=\"toastContainer\" class=\"fixed bottom-6 right-6 z-50 flex flex-col space-y-2 pointer-events-none\"></div>\n\n    <!-- Script Application Logic -->\n    <script>\n        // Mock Database complying with /api/v1/meetings specification\n        let meetings = [\n            {\n                id: \"m-101\",\n                title: \"Sprint 42 Retrospective\",\n                category: \"Engineering\",\n                organizer: \"Sarah Jenkins\",\n                datetime: \"2023-11-20T10:00\",\n                status: \"upcoming\",\n                agenda: \"Review velocity metrics, discuss blockers, analyze bug burn-down chart.\"\n            },\n            {\n                id: \"m-102\",\n                title: \"Q4 Roadmap Strategy\",\n                category: \"Product\",\n                organizer: \"David Miller\",\n                datetime: \"2023-11-20T14:30\",\n                status: \"upcoming\",\n                agenda: \"Align core feature deliverables with target executive outcomes for Q4.\"\n            },\n            {\n                id: \"m-103\",\n                title: \"Board Executive Briefing\",\n                category: \"Executive\",\n                organizer: \"Eleanor Vance\",\n                datetime: \"2023-11-21T09:00\",\n                status: \"upcoming\",\n                agenda: \"Financial performance summary and capital allocation strategy.\"\n            },\n            {\n                id: \"m-104\",\n                title: \"API Gateway Migration\",\n                category: \"Engineering\",\n                organizer: \"Alex Mercer\",\n                datetime: \"2023-11-18T11:00\",\n                status: \"completed\",\n                agenda: \"Transition legacy REST endpoints to GraphQL gateway infrastructure.\"\n            },\n            {\n                id: \"m-105\",\n                title: \"Design System Sync v2\",\n                category: \"Product\",\n                organizer: \"Chloe Grace\",\n                datetime: \"2023-11-17T15:00\",\n                status: \"completed\",\n                agenda: \"Token consolidation across Tailwind components and Figma variables.\"\n            },\n            {\n                id: \"m-106\",\n                title: \"Database Indexing & Scaling\",\n                category: \"Engineering\",\n                organizer: \"Marcus Thorne\",\n                datetime: \"2023-11-16T16:30\",\n                status: \"completed\",\n                agenda: \"Review query execution plans and optimize high-traffic PostgreSQL tables.\"\n            }\n        ];\n\n        let currentFilter = 'all';\n        let currentCategory = '';\n        let searchQuery = '';\n        let activeMeetingId = null;\n\n        // Initialization\n        document.addEventListener('DOMContentLoaded', () => {\n            renderMeetings();\n            updateMetrics();\n\n            // Search listener\n            document.getElementById('globalSearch').addEventListener('input', (e) => {\n                searchQuery = e.target.value.toLowerCase();\n                renderMeetings();\n            });\n        });\n\n        function renderMeetings() {\n            const tbody = document.getElementById('meetingsTableBody');\n            tbody.innerHTML = '';\n\n            let filtered = meetings.filter(m => {\n                const matchesTab = currentFilter === 'all' || m.status === currentFilter;\n                const matchesCat = !currentCategory || m.category === currentCategory;\n                const matchesSearch = !searchQuery || m.title.toLowerCase().includes(searchQuery) || m.organizer.toLowerCase().includes(searchQuery) || m.agenda.toLowerCase().includes(searchQuery);\n                return matchesTab && matchesCat && matchesSearch;\n            });\n\n            if (filtered.length === 0) {\n                tbody.innerHTML = `\n                    <tr>\n                        <td colspan=\"6\" class=\"text-center py-12 text-slate-500\">\n                            <div class=\"flex flex-col items-center justify-center space-y-3\">\n                                <div class=\"h-12 w-12 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 text-lg\">\n                                    <i class=\"fa-solid fa-folder-open\"></i>\n                                </div>\n                                <p class=\"text-sm font-medium\">No meetings found matching parameters.</p>\n                            </div>\n                        </td>\n                    </tr>\n                `;\n                document.getElementById('tableCounter').innerText = `Showing 0 entries`;\n                return;\n            }\n\n            filtered.forEach(m => {\n                const badgeColor = m.status === 'upcoming' \n                    ? 'bg-sky-500/10 text-sky-400 border-sky-500/20' \n                    : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';\n\n                const categoryIcon = m.category === 'Engineering' ? 'fa-code text-indigo-400' : m.category === 'Product' ? 'fa-layer-group text-sky-400' : 'fa-chess text-emerald-400';\n\n                const tr = document.createElement('tr');\n                tr.className = 'hover:bg-slate-900/40 transition-all group cursor-pointer';\n                tr.onclick = (e) => {\n                    // Prevent trigger if clicking action buttons directly\n                    if(!e.target.closest('button')) openDetails(m.id);\n                };\n\n                tr.innerHTML = `\n                    <td class=\"py-4 px-6 font-medium text-slate-200\">\n                        <div class=\"flex items-center gap-2.5\">\n                            <span class=\"h-2 w-2 rounded-full ${m.status === 'upcoming' ? 'bg-sky-400' : 'bg-slate-600'}\"></span>\n                            ${m.title}\n                        </div>\n                    </td>\n                    <td class=\"py-4 px-6 text-slate-300\">\n                        <span class=\"inline-flex items-center gap-1.5 text-xs\">\n                            <i class=\"fa-solid ${categoryIcon}\"></i> ${m.category}\n                        </span>\n                    </td>\n                    <td class=\"py-4 px-6 text-slate-300 text-xs\">${m.organizer}</td>\n                    <td class=\"py-4 px-6 text-slate-400 text-xs\">${formatDate(m.datetime)}</td>\n                    <td class=\"py-4 px-6\">\n                        <span class=\"px-2.5 py-1 rounded-full text-[11px] font-semibold border ${badgeColor} capitalize\">\n                            ${m.status}\n                        </span>\n                    </td>\n                    <td class=\"py-4 px-6 text-right\">\n                        <div class=\"flex items-center justify-end space-x-2 opacity-80 group-hover:opacity-100 transition-all\">\n                            <button onclick=\"openEditModal('${m.id}')\" class=\"h-8 w-8 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 hover:text-slate-200 flex items-center justify-center transition-all\" title=\"Edit\">\n                                <i class=\"fa-solid fa-pen-to-square text-xs\"></i>\n                            </button>\n                            <button onclick=\"openDetails('${m.id}')\" class=\"h-8 w-8 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-400 hover:text-slate-200 flex items-center justify-center transition-all\" title=\"Details\">\n                                <i class=\"fa-solid fa-arrow-right text-xs\"></i>\n                            </button>\n                        </div>\n                    </td>\n                `;\n                tbody.appendChild(tr);\n            });\n\n            document.getElementById('tableCounter').innerText = `Showing ${filtered.length} of ${meetings.length} entries`;\n        }\n\n        function updateMetrics() {\n            document.getElementById('totalCount').innerText = meetings.length;\n            const upcomingCount = meetings.filter(m => m.status === 'upcoming').length;\n            document.getElementById('todayCount').innerText = upcomingCount;\n        }\n\n        function formatDate(dtStr) {\n            if(!dtStr) return '';\n            const options = { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };\n            return new Date(dtStr).toLocaleDateString('en-US', options);\n        }\n\n        // Filters & Tabs\n        function switchTab(tab, btn) {\n            currentFilter = tab;\n            document.querySelectorAll('.tab-btn').forEach(b => {\n                b.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 text-slate-400 hover:text-white border border-slate-800 transition-all whitespace-nowrap';\n            });\n            btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-brand-600 text-white shadow-md transition-all whitespace-nowrap';\n            renderMeetings();\n        }\n\n        function filterView(tab, element) {\n            currentFilter = tab;\n            document.querySelectorAll('.sidebar-link').forEach(l => {\n                l.className = 'sidebar-link flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-slate-200 hover:bg-slate-900 transition-all';\n            });\n            element.className = 'sidebar-link flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium bg-brand-600/10 text-brand-400 border border-brand-500/20 transition-all';\n            renderMeetings();\n        }\n\n        function filterCategory(category, element) {\n            currentCategory = currentCategory === category ? '' : category;\n            document.querySelectorAll('.category-link').forEach(l => l.classList.remove('bg-slate-900', 'text-slate-200'));\n            if(currentCategory) {\n                element.classList.add('bg-slate-900', 'text-slate-200');\n            }\n            renderMeetings();\n        }\n\n        function applyFilters() {\n            currentCategory = document.getElementById('categoryFilter').value;\n            renderMeetings();\n        }\n\n        // Modal Actions\n        function openModal() {\n            document.getElementById('modalTitle').innerText = 'Schedule New Meeting';\n            document.getElementById('meetingForm').reset();\n            document.getElementById('meetingId').value = '';\n            // Set default date to now\n            const now = new Date();\n            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());\n            document.getElementById('datetime').value = now.toISOString().slice(0,16);\n            document.getElementById('meetingModal').classList.remove('hidden');\n        }\n\n        function openEditModal(id) {\n            const m = meetings.find(item => item.id === id);\n            if(!m) return;\n\n            document.getElementById('modalTitle').innerText = 'Edit Meeting Record';\n            document.getElementById('meetingId').value = m.id;\n            document.getElementById('title').value = m.title;\n            document.getElementById('category').value = m.category;\n            document.getElementById('organizer').value = m.organizer;\n            document.getElementById('datetime').value = m.datetime;\n            document.getElementById('status').value = m.status;\n            document.getElementById('agenda').value = m.agenda;\n\n            document.getElementById('meetingModal').classList.remove('hidden');\n        }\n\n        function closeModal() {\n            document.getElementById('meetingModal').classList.add('hidden');\n        }\n\n        // Form Submit Handler (API Mock POST / PUT)\n        function handleFormSubmit(e) {\n            e.preventDefault();\n            const id = document.getElementById('meetingId').value;\n            const data = {\n                id: id ? id : 'm-' + Math.floor(Math.random() * 900 + 100),\n                title: document.getElementById('title').value,\n                category: document.getElementById('category').value,\n                organizer: document.getElementById('organizer').value,\n                datetime: document.getElementById('datetime').value,\n                status: document.getElementById('status').value,\n                agenda: document.getElementById('agenda').value\n            };\n\n            if(id) {\n                const index = meetings.findIndex(m => m.id === id);\n                if(index !== -1) meetings[index] = data;\n                showToast('Meeting updated successfully via API PATCH', 'success');\n            } else {\n                meetings.unshift(data);\n                showToast('New meeting created successfully via API POST', 'success');\n            }\n\n            closeModal();\n            renderMeetings();\n            updateMetrics();\n        }\n\n        // Details Drawer\n        function openDetails(id) {\n            activeMeetingId = id;\n            const m = meetings.find(item => item.id === id);\n            if(!m) return;\n\n            const container = document.getElementById('drawerContent');\n            container.innerHTML = `\n                <div class=\"space-y-4\">\n                    <div>\n                        <span class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider\">Meeting Title</span>\n                        <h4 class=\"text-lg font-bold text-slate-100 mt-1\">${m.title}</h4>\n                    </div>\n\n                    <div class=\"grid grid-cols-2 gap-4 pt-2\">\n                        <div class=\"glass-card p-3 rounded-xl border border-slate-800\">\n                            <span class=\"text-[11px] font-medium text-slate-400 block\">Category</span>\n                            <span class=\"text-sm font-semibold text-slate-200 mt-1 inline-block\">${m.category}</span>\n                        </div>\n                        <div class=\"glass-card p-3 rounded-xl border border-slate-800\">\n                            <span class=\"text-[11px] font-medium text-slate-400 block\">Status</span>\n                            <span class=\"text-sm font-semibold capitalize mt-1 inline-block ${m.status === 'upcoming' ? 'text-sky-400' : 'text-emerald-400'}\">${m.status}</span>\n                        </div>\n                    </div>\n\n                    <div class=\"glass-card p-3 rounded-xl border border-slate-800 space-y-1\">\n                        <span class=\"text-[11px] font-medium text-slate-400 block\">Organizer</span>\n                        <div class=\"flex items-center space-x-2 text-sm text-slate-200 font-medium\">\n                            <div class=\"h-6 w-6 rounded-full bg-slate-800 flex items-center justify-center text-xs text-brand-400\">\n                                ${m.organizer.charAt(0)}\n                            </div>\n                            <span>${m.organizer}</span>\n                        </div>\n                    </div>\n\n                    <div class=\"glass-card p-3 rounded-xl border border-slate-800\">\n                        <span class=\"text-[11px] font-medium text-slate-400 block\">Scheduled Timestamp</span>\n                        <span class=\"text-sm font-semibold text-slate-200 mt-1 inline-block\"><i class=\"fa-solid fa-calendar mr-1.5 text-brand-400\"></i>${formatDate(m.datetime)}</span>\n                    </div>\n\n                    <div class=\"pt-2\">\n                        <span class=\"text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2\">Agenda & Objectives</span>\n                        <div class=\"bg-slate-900 border border-slate-800 rounded-xl p-4 text-sm text-slate-300 leading-relaxed\">\n                            ${m.agenda || 'No agenda recorded for this session.'}\n                        </div>\n                    </div>\n                </div>\n            `;\n\n            document.getElementById('detailsDrawer').classList.remove('hidden');\n        }\n\n        function closeDetails() {\n            document.getElementById('detailsDrawer').classList.add('hidden');\n            activeMeetingId = null;\n        }\n\n        function deleteMeetingFromDrawer() {\n            if(!activeMeetingId) return;\n            if(confirm('Are you sure you want to delete this meeting record?')) {\n                meetings = meetings.filter(m => m.id !== activeMeetingId);\n                closeDetails();\n                renderMeetings();\n                updateMetrics();\n                showToast('Meeting record deleted successfully', 'error');\n            }\n        }\n\n        // Toast Notification System\n        function showToast(message, type = 'success') {\n            const container = document.getElementById('toastContainer');\n            const toast = document.createElement('div');\n            const icon = type === 'success' ? 'fa-circle-check text-emerald-400' : 'fa-circle-exclamation text-rose-400';\n            const border = type === 'success' ? 'border-emerald-500/30 bg-emerald-950/40' : 'border-rose-500/30 bg-rose-950/40';\n\n            toast.className = `glass-card pointer-events-auto flex items-center space-x-3 px-4 py-3 rounded-xl border ${border} text-xs text-slate-200 shadow-xl animate-in slide-in-from-bottom duration-200`;\n            toast.innerHTML = `\n                <i class=\"fa-solid ${icon} text-base\"></i>\n                <span class=\"font-medium\">${message}</span>\n            `;\n\n            container.appendChild(toast);\n\n            setTimeout(() => {\n                toast.classList.add('opacity-0', 'transition-all', 'duration-300');\n                setTimeout(() => toast.remove(), 300);\n            }, 3500);\n        }\n    </script>\n</body>\n</html>"
}