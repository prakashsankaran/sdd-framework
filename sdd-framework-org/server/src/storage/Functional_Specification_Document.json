{
  "html": "<article style=\"background-color: #0f172a; color: #e2e8f0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; padding: 40px; line-height: 1.6;\">\n\n    <!-- HEADER / DOCUMENT INFORMATION -->\n    <header style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 40px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\">\n        <div style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Functional Specification Document</div>\n        <h1 style=\"color: #6366f1; font-size: 32px; margin: 0 0 10px 0;\">MEETING MANAGER</h1>\n        <p style=\"color: #94a3b8; font-size: 16px; margin: 0 0 20px 0;\">Enterprise Meeting Management &amp; Collaboration Platform</p>\n        \n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; border-top: 1px solid #334155; padding-top: 20px; font-size: 14px;\">\n            <div><strong style=\"color: #94a3b8;\">Document Title:</strong> Functional Specification</div>\n            <div><strong style=\"color: #94a3b8;\">Project Name:</strong> Meeting Manager</div>\n            <div><strong style=\"color: #94a3b8;\">Version:</strong> 1.0.0</div>\n            <div><strong style=\"color: #94a3b8;\">Status:</strong> Draft / Ready for Review</div>\n            <div><strong style=\"color: #94a3b8;\">Author:</strong> Principal Business Analyst &amp; Senior Technical Writer</div>\n            <div><strong style=\"color: #94a3b8;\">Reviewers:</strong> Solutions Architect, Product Manager</div>\n            <div><strong style=\"color: #94a3b8;\">Approvers:</strong> Director of Engineering, Head of Product</div>\n        </div>\n\n        <div style=\"margin-top: 20px; border-top: 1px solid #334155; padding-top: 15px;\">\n            <h4 style=\"color: #6366f1; font-size: 14px; margin: 0 0 8px 0;\">Revision Log</h4>\n            <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n                <thead>\n                    <tr style=\"border-bottom: 1px solid #334155; text-align: left; color: #94a3b8;\">\n                        <th style=\"padding: 6px;\">Version</th>\n                        <th style=\"padding: 6px;\">Date</th>\n                        <th style=\"padding: 6px;\">Author</th>\n                        <th style=\"padding: 6px;\">Description</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <tr>\n                        <td style=\"padding: 6px; border-bottom: 1px solid #334155;\">1.0.0</td>\n                        <td style=\"padding: 6px; border-bottom: 1px solid #334155;\">2023-10-25</td>\n                        <td style=\"padding: 6px; border-bottom: 1px solid #334155;\">Principal BA</td>\n                        <td style=\"padding: 6px; border-bottom: 1px solid #334155;\">Initial draft generated from core system specifications.</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </header>\n\n    <!-- TABLE OF CONTENTS -->\n    <nav style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 40px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Navigation</span>\n        <h2 style=\"color: #6366f1; font-size: 22px; margin-top: 0;\">Table of Contents</h2>\n        <ul style=\"list-style-type: none; padding-left: 0; columns: 2; font-size: 14px;\">\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-1\" style=\"color: #22d3ee; text-decoration: none;\">1. Introduction</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-2\" style=\"color: #22d3ee; text-decoration: none;\">2. Business Context</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-3\" style=\"color: #22d3ee; text-decoration: none;\">3. Functional Overview</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-4\" style=\"color: #22d3ee; text-decoration: none;\">4. User Roles</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-5\" style=\"color: #22d3ee; text-decoration: none;\">5. Functional Requirements</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-6\" style=\"color: #22d3ee; text-decoration: none;\">6. Business Rules</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-7\" style=\"color: #22d3ee; text-decoration: none;\">7. UI Specification</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-8\" style=\"color: #22d3ee; text-decoration: none;\">8. Field Specifications</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-13\" style=\"color: #22d3ee; text-decoration: none;\">9. Error Handling</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-14\" style=\"color: #22d3ee; text-decoration: none;\">10. Non-Functional Requirements</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-15\" style=\"color: #22d3ee; text-decoration: none;\">11. Assumptions &amp; Risks</a></li>\n            <li style=\"margin-bottom: 8px;\"><a href=\"#section-18\" style=\"color: #22d3ee; text-decoration: none;\">12. Appendix</a></li>\n        </ul>\n    </nav>\n\n    <!-- SECTION 1 -->\n    <section id=\"section-1\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 1</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">1. Introduction</h2>\n        \n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">1.1 Purpose</h3>\n        <p>This Functional Specification Document (FSD) defines the comprehensive behavior, data models, workflows, and user interface layouts for the Meeting Manager platform. It acts as the definitive baseline for software engineers, quality assurance testers, and project stakeholders to design, implement, and validate the system.</p>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">1.2 Scope</h3>\n        <p>The Meeting Manager system encompasses end-to-end meeting lifecycle operations, including user authentication, meeting creation and scheduling, role assignments (hosts, participants), agenda management, real-time tracking, and administrative controls. Out-of-scope modules include custom telephony integrations and third-party accounting systems.</p>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">1.3 Objectives</h3>\n        <ul>\n            <li>Streamline corporate meeting scheduling and resource allocation.</li>\n            <li>Enforce structural agenda adherence and tracking.</li>\n            <li>Provide clear, role-based access control for administrative oversight.</li>\n        </ul>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">1.4 Intended Audience</h3>\n        <p>This document is intended for Product Owners, Software Developers, QA Engineers, Enterprise Architects, and Business Stakeholders.</p>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">1.5 References</h3>\n        <ul>\n            <li>Business Requirements Document (BRD) - Meeting Manager v1.0</li>\n            <li>UI Wireframe Repository - Figma Project #MM-2023</li>\n            <li>Enterprise Security and Compliance Guidelines v4.2</li>\n        </ul>\n    </section>\n\n    <!-- SECTION 2 -->\n    <section id=\"section-2\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 2</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">2. Business Context</h2>\n        \n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Current Process (As-Is)</h3>\n        <p>Meetings are currently scheduled via fragmented calendar tools with manual email threads for agendas, leading to unstructured discussions, missing notes, and zero systemic enforcement of meeting objectives.</p>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Problems &amp; Pain Points</h3>\n        <ul>\n            <li>Lack of centralized meeting agendas and structured tracking.</li>\n            <li>Confusion regarding roles (who is hosting vs. participating).</li>\n            <li>Time wastage due to unorganized discussion flows.</li>\n        </ul>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Future Process (To-Be)</h3>\n        <p>A centralized platform enforcing strict scheduling parameters, structured agenda itemization, clear role assignments, and robust session management.</p>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Business Benefits</h3>\n        <ul>\n            <li>Increased operational efficiency and shorter meeting durations.</li>\n            <li>Improved accountability through strict task and agenda tracking.</li>\n            <li>Standardized access management across organizational units.</li>\n        </ul>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Assumptions, Dependencies &amp; Constraints</h3>\n        <ul>\n            <li><strong>Assumptions:</strong> Users have modern web browsers with active internet connectivity.</li>\n            <li><strong>Dependencies:</strong> Identity Provider (IdP) for Single Sign-On (SSO).</li>\n            <li><strong>Constraints:</strong> System must comply with enterprise data retention policies.</li>\n        </ul>\n    </section>\n\n    <!-- SECTION 3 -->\n    <section id=\"section-3\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 3</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">3. Functional Overview</h2>\n        <p>The Meeting Manager system comprises the following primary modules:</p>\n        <ul>\n            <li><strong>Authentication &amp; User Management:</strong> Role assignments, credential validation, and profile management.</li>\n            <li><strong>Meeting Scheduling Module:</strong> Creation, updating, and cancellation of meetings, including date/time and agenda setup.</li>\n            <li><strong>Participant Management:</strong> Adding, removing, and updating participant roles within a meeting.</li>\n            <li><strong>Session &amp; Dashboard Control:</strong> Real-time overview of active, upcoming, and past meetings.</li>\n        </ul>\n    </section>\n\n    <!-- SECTION 4 -->\n    <section id=\"section-4\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 4</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">4. User Roles &amp; Access Matrix</h2>\n        \n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Role Definitions</h3>\n        <ul>\n            <li><strong>Administrator:</strong> Manages global system configurations, user access profiles, and system logs.</li>\n            <li><strong>Host:</strong> Creates meetings, defines agendas, invites participants, and moderates the live session.</li>\n            <li><strong>Participant:</strong> Attends meetings, views agendas, and contributes to discussions.</li>\n        </ul>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Access Control Matrix</h3>\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 10px;\">\n            <thead>\n                <tr style=\"border-bottom: 1px solid #334155; text-align: left; color: #94a3b8;\">\n                    <th style=\"padding: 10px;\">Module / Feature</th>\n                    <th style=\"padding: 10px;\">Administrator</th>\n                    <th style=\"padding: 10px;\">Host</th>\n                    <th style=\"padding: 10px;\">Participant</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px;\">User Management</td>\n                    <td style=\"padding: 10px; color: #22d3ee;\">Allowed</td>\n                    <td style=\"padding: 10px; color: #f43f5e;\">Denied</td>\n                    <td style=\"padding: 10px; color: #f43f5e;\">Denied</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px;\">Create Meeting</td>\n                    <td style=\"padding: 10px; color: #22d3ee;\">Allowed</td>\n                    <td style=\"padding: 10px; color: #22d3ee;\">Allowed</td>\n                    <td style=\"padding: 10px; color: #f43f5e;\">Denied</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px;\">View Meeting Agenda</td>\n                    <td style=\"padding: 10px; color: #22d3ee;\">Allowed</td>\n                    <td style=\"padding: 10px; color: #22d3ee;\">Allowed</td>\n                    <td style=\"padding: 10px; color: #22d3ee;\">Allowed</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px;\">System Global Configuration</td>\n                    <td style=\"padding: 10px; color: #22d3ee;\">Allowed</td>\n                    <td style=\"padding: 10px; color: #f43f5e;\">Denied</td>\n                    <td style=\"padding: 10px; color: #f43f5e;\">Denied</td>\n                </tr>\n            </tbody>\n        </table>\n    </section>\n\n    <!-- SECTION 5 -->\n    <section id=\"section-5\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 5</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">5. Functional Requirements</h2>\n\n        <!-- FR-001 -->\n        <div style=\"background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 20px; margin-bottom: 20px;\">\n            <h3 style=\"color: #22d3ee; margin-top: 0;\">FR-001: Meeting Creation</h3>\n            <p><strong>Description:</strong> Allows authorized users (Hosts and Administrators) to schedule and create new meetings within the system.</p>\n            <ul style=\"list-style-type: none; padding-left: 0; font-size: 14px; color: #94a3b8;\">\n                <li><strong style=\"color: #e2e8f0;\">Priority:</strong> Critical</li>\n                <li><strong style=\"color: #e2e8f0;\">Actor:</strong> Host, Administrator</li>\n                <li><strong style=\"color: #e2e8f0;\">Trigger:</strong> User clicks the \"Create Meeting\" button on the main dashboard.</li>\n                <li><strong style=\"color: #e2e8f0;\">Preconditions:</strong> User must be authenticated and possess Host or Administrator privileges.</li>\n            </ul>\n            <h4 style=\"color: #6366f1; font-size: 15px; margin-bottom: 5px;\">Main Flow:</h4>\n            <ol style=\"margin-top: 0; font-size: 14px;\">\n                <li>User navigates to the Dashboard and selects \"Create Meeting\".</li>\n                <li>System presents the Meeting Creation Form.</li>\n                <li>User inputs meeting title, start date, end date, and description.</li>\n                <li>User clicks \"Save and Continue\".</li>\n                <li>System validates inputs against Business Rules (BR-001).</li>\n                <li>System persists meeting record to database and displays success confirmation.</li>\n            </ol>\n            <h4 style=\"color: #6366f1; font-size: 15px; margin-bottom: 5px;\">Alternative / Exception Flow:</h4>\n            <p style=\"font-size: 14px; margin-top: 0;\">If validation fails, system highlights invalid fields and prompts the user to correct errors without losing entered data.</p>\n            <p style=\"font-size: 14px;\"><strong style=\"color: #e2e8f0;\">Acceptance Criteria:</strong> System successfully creates a meeting record when all mandatory fields are provided with valid formats. Meeting appears immediately on the user's dashboard calendar view.</p>\n            <div style=\"font-size: 12px; color: #94a3b8; border-top: 1px solid #334155; padding-top: 10px; margin-top: 10px;\">\n                <span>Business Rules: BR-001</span> | \n                <span>Related Screens: SCR-002</span> | \n                <span>Related APIs: POST /api/v1/meetings</span> | \n                <span>DB Tables: meetings</span>\n            </div>\n        </div>\n\n        <!-- FR-002 -->\n        <div style=\"background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 20px; margin-bottom: 20px;\">\n            <h3 style=\"color: #22d3ee; margin-top: 0;\">FR-002: Add Meeting Agenda</h3>\n            <p><strong>Description:</strong> Enables hosts to append structured agenda items to an existing meeting.</p>\n            <ul style=\"list-style-type: none; padding-left: 0; font-size: 14px; color: #94a3b8;\">\n                <li><strong style=\"color: #e2e8f0;\">Priority:</strong> High</li>\n                <li><strong style=\"color: #e2e8f0;\">Actor:</strong> Host, Administrator</li>\n                <li><strong style=\"color: #e2e8f0;\">Trigger:</strong> User selects an existing meeting and clicks \"Add Agenda Item\".</li>\n                <li><strong style=\"color: #e2e8f0;\">Preconditions:</strong> Meeting must be in \"Scheduled\" status.</li>\n            </ul>\n            <h4 style=\"color: #6366f1; font-size: 15px; margin-bottom: 5px;\">Main Flow:</h4>\n            <ol style=\"margin-top: 0; font-size: 14px;\">\n                <li>User accesses meeting details view.</li>\n                <li>User clicks \"Add Agenda Item\".</li>\n                <li>User enters agenda title, description, and allocated duration in minutes.</li>\n                <li>User clicks \"Save Item\".</li>\n                <li>System validates duration against total meeting length (BR-002).</li>\n                <li>System adds agenda item to the meeting agenda list.</li>\n            </ol>\n            <p style=\"font-size: 14px;\"><strong style=\"color: #e2e8f0;\">Acceptance Criteria:</strong> Agenda items are cleanly displayed in sequential order with cumulative duration indicators.</p>\n            <div style=\"font-size: 12px; color: #94a3b8; border-top: 1px solid #334155; padding-top: 10px; margin-top: 10px;\">\n                <span>Business Rules: BR-002</span> | \n                <span>Related Screens: SCR-003</span> | \n                <span>Related APIs: POST /api/v1/meetings/{id}/agenda</span> | \n                <span>DB Tables: meeting_agendas</span>\n            </div>\n        </div>\n\n        <!-- FR-003 -->\n        <div style=\"background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 20px; margin-bottom: 20px;\">\n            <h3 style=\"color: #22d3ee; margin-top: 0;\">FR-003: Participant Management</h3>\n            <p><strong>Description:</strong> Allows hosts to add or remove participants from a scheduled meeting.</p>\n            <ul style=\"list-style-type: none; padding-left: 0; font-size: 14px; color: #94a3b8;\">\n                <li><strong style=\"color: #e2e8f0;\">Priority:</strong> High</li>\n                <li><strong style=\"color: #e2e8f0;\">Actor:</strong> Host, Administrator</li>\n                <li><strong style=\"color: #e2e8f0;\">Trigger:</strong> User navigates to the \"Participants\" tab within meeting settings.</li>\n                <li><strong style=\"color: #e2e8f0;\">Preconditions:</strong> Meeting must exist and be editable.</li>\n            </ul>\n            <h4 style=\"color: #6366f1; font-size: 15px; margin-bottom: 5px;\">Main Flow:</h4>\n            <ol style=\"margin-top: 0; font-size: 14px;\">\n                <li>User searches for user by email or name.</li>\n                <li>User selects user from directory and clicks \"Add to Meeting\".</li>\n                <li>System links user account as meeting participant.</li>\n            </ol>\n            <p style=\"font-size: 14px;\"><strong style=\"color: #e2e8f0;\">Acceptance Criteria:</strong> Added participants immediately appear in the participant roster table.</p>\n            <div style=\"font-size: 12px; color: #94a3b8; border-top: 1px solid #334155; padding-top: 10px; margin-top: 10px;\">\n                <span>Business Rules: BR-003</span> | \n                <span>Related Screens: SCR-004</span> | \n                <span>Related APIs: POST /api/v1/meetings/{id}/participants</span> | \n                <span>DB Tables: meeting_participants</span>\n            </div>\n        </div>\n\n        <!-- FR-004 -->\n        <div style=\"background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 20px;\">\n            <h3 style=\"color: #22d3ee; margin-top: 0;\">FR-004: Meeting Cancellation</h3>\n            <p><strong>Description:</strong> Allows hosts to cancel an upcoming meeting.</p>\n            <ul style=\"list-style-type: none; padding-left: 0; font-size: 14px; color: #94a3b8;\">\n                <li><strong style=\"color: #e2e8f0;\">Priority:</strong> Medium</li>\n                <li><strong style=\"color: #e2e8f0;\">Actor:</strong> Host, Administrator</li>\n                <li><strong style=\"color: #e2e8f0;\">Trigger:</strong> User clicks \"Cancel Meeting\" action button.</li>\n                <li><strong style=\"color: #e2e8f0;\">Preconditions:</strong> Meeting status is \"Scheduled\".</li>\n            </ul>\n            <h4 style=\"color: #6366f1; font-size: 15px; margin-bottom: 5px;\">Main Flow:</h4>\n            <ol style=\"margin-top: 0; font-size: 14px;\">\n                <li>User clicks \"Cancel Meeting\".</li>\n                <li>System prompts for cancellation confirmation and optional reason.</li>\n                <li>User confirms cancellation.</li>\n                <li>System updates meeting status to \"Cancelled\".</li>\n            </ol>\n            <p style=\"font-size: 14px;\"><strong style=\"color: #e2e8f0;\">Acceptance Criteria:</strong> Cancelled meetings are locked against further edits and updated across participant views.</p>\n            <div style=\"font-size: 12px; color: #94a3b8; border-top: 1px solid #334155; padding-top: 10px; margin-top: 10px;\">\n                <span>Business Rules: BR-004</span> | \n                <span>Related Screens: SCR-002</span> | \n                <span>Related APIs: PATCH /api/v1/meetings/{id}/cancel</span> | \n                <span>DB Tables: meetings</span>\n            </div>\n        </div>\n    </section>\n\n    <!-- SECTION 6 -->\n    <section id=\"section-6\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 6</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">6. Business Rules</h2>\n        \n        <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n            <thead>\n                <tr style=\"border-bottom: 1px solid #334155; text-align: left; color: #94a3b8;\">\n                    <th style=\"padding: 10px;\">Rule ID</th>\n                    <th style=\"padding: 10px;\">Title</th>\n                    <th style=\"padding: 10px;\">Description</th>\n                    <th style=\"padding: 10px;\">Enforcement Point</th>\n                    <th style=\"padding: 10px;\">Priority</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px; font-weight: bold; color: #22d3ee;\">BR-001</td>\n                    <td style=\"padding: 10px;\">Future Meeting Scheduling</td>\n                    <td style=\"padding: 10px;\">Meeting start date and time must be set in the future relative to server time. Past dates are rejected.</td>\n                    <td style=\"padding: 10px;\">API / UI Validation</td>\n                    <td style=\"padding: 10px;\">Critical</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px; font-weight: bold; color: #22d3ee;\">BR-002</td>\n                    <td style=\"padding: 10px;\">Agenda Duration Limit</td>\n                    <td style=\"padding: 10px;\">The sum of all agenda item durations cannot exceed the total scheduled duration of the meeting.</td>\n                    <td style=\"padding: 10px;\">API Service Layer</td>\n                    <td style=\"padding: 10px;\">High</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px; font-weight: bold; color: #22d3ee;\">BR-003</td>\n                    <td style=\"padding: 10px;\">Host Modification Rights</td>\n                    <td style=\"padding: 10px;\">Only the designated meeting Host or an Administrator can modify meeting details or agenda items.</td>\n                    <td style=\"padding: 10px;\">Authorization Middleware</td>\n                    <td style=\"padding: 10px;\">Critical</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px; font-weight: bold; color: #22d3ee;\">BR-004</td>\n                    <td style=\"padding: 10px;\">Cancellation Lock</td>\n                    <td style=\"padding: 10px;\">Once a meeting is marked as Cancelled or Completed, no further edits to agenda or participant lists are permitted.</td>\n                    <td style=\"padding: 10px;\">Database Constraint / Service</td>\n                    <td style=\"padding: 10px;\">Medium</td>\n                </tr>\n            </tbody>\n        </table>\n    </section>\n\n    <!-- SECTION 7 -->\n    <section id=\"section-7\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 7</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">7. UI Specification</h2>\n        \n        <div style=\"background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 20px; margin-bottom: 20px;\">\n            <h3 style=\"color: #22d3ee; margin-top: 0;\">SCR-002: Meeting Creation Screen</h3>\n            <p><strong>Purpose:</strong> Provides interface inputs for scheduling a new meeting.</p>\n            <p><strong>Navigation Path:</strong> Dashboard &gt; Click \"Create Meeting\"</p>\n            <p><strong>Buttons / Actions:</strong> [Save and Continue], [Cancel]</p>\n            <p><strong>Validation Rules:</strong> Title is required (max 150 chars). Start Date must be &gt; current timestamp.</p>\n            <p><strong>Responsive Behaviour:</strong> Form fields stack vertically on mobile screens and display in a two-column grid on desktop.</p>\n            <p><strong>Accessibility Notes:</strong> All input fields feature explicit ARIA labels and keyboard tab navigation support.</p>\n        </div>\n    </section>\n\n    <!-- SECTION 8 -->\n    <section id=\"section-8\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 8</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">8. Field Specifications</h2>\n        \n        <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n            <thead>\n                <tr style=\"border-bottom: 1px solid #334155; text-align: left; color: #94a3b8;\">\n                    <th style=\"padding: 8px;\">Field Name</th>\n                    <th style=\"padding: 8px;\">Type</th>\n                    <th style=\"padding: 8px;\">Mandatory</th>\n                    <th style=\"padding: 8px;\">Validation</th>\n                    <th style=\"padding: 8px;\">Editable</th>\n                    <th style=\"padding: 8px;\">Default</th>\n                    <th style=\"padding: 8px;\">Max Length</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 8px; font-weight: bold;\">meeting_title</td>\n                    <td style=\"padding: 8px;\">String</td>\n                    <td style=\"padding: 8px; color: #22d3ee;\">Yes</td>\n                    <td style=\"padding: 8px;\">Alphanumeric &amp; spaces</td>\n                    <td style=\"padding: 8px;\">Yes</td>\n                    <td style=\"padding: 8px;\">None</td>\n                    <td style=\"padding: 8px;\">150</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 8px; font-weight: bold;\">start_datetime</td>\n                    <td style=\"padding: 8px;\">DateTime</td>\n                    <td style=\"padding: 8px; color: #22d3ee;\">Yes</td>\n                    <td style=\"padding: 8px;\">Must be &gt; now (BR-001)</td>\n                    <td style=\"padding: 8px;\">Yes</td>\n                    <td style=\"padding: 8px;\">None</td>\n                    <td style=\"padding: 8px;\">-</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 8px; font-weight: bold;\">agenda_duration</td>\n                    <td style=\"padding: 8px;\">Integer</td>\n                    <td style=\"padding: 8px; color: #22d3ee;\">Yes</td>\n                    <td style=\"padding: 8px;\">Positive integer (&gt; 0)</td>\n                    <td style=\"padding: 8px;\">Yes</td>\n                    <td style=\"padding: 8px;\">15</td>\n                    <td style=\"padding: 8px;\">4 digits</td>\n                </tr>\n            </tbody>\n        </table>\n    </section>\n\n    <!-- SECTION 13 -->\n    <section id=\"section-13\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 9</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">13. Error Handling</h2>\n        \n        <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n            <thead>\n                <tr style=\"border-bottom: 1px solid #334155; text-align: left; color: #94a3b8;\">\n                    <th style=\"padding: 10px;\">Error Code</th>\n                    <th style=\"padding: 10px;\">Error Type</th>\n                    <th style=\"padding: 10px;\">Trigger Condition</th>\n                    <th style=\"padding: 10px;\">User Message</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px; font-weight: bold; color: #f43f5e;\">ERR-VAL-001</td>\n                    <td style=\"padding: 10px;\">Validation Error</td>\n                    <td style=\"padding: 10px;\">Meeting date set in the past.</td>\n                    <td style=\"padding: 10px;\">Meeting start time must be scheduled in the future.</td>\n                </tr>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px; font-weight: bold; color: #f43f5e;\">ERR-AUTH-003</td>\n                    <td style=\"padding: 10px;\">Authorization Error</td>\n                    <td style=\"padding: 10px;\">Participant attempts to edit meeting details.</td>\n                    <td style=\"padding: 10px;\">You do not have permission to modify this meeting.</td>\n                </tr>\n            </tbody>\n        </table>\n    </section>\n\n    <!-- SECTION 14 -->\n    <section id=\"section-14\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 10</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">14. Non-Functional Requirements</h2>\n        <ul>\n            <li><strong>Performance:</strong> API response times for meeting creation and retrieval must not exceed 500ms under normal load.</li>\n            <li><strong>Availability:</strong> System uptime target of 99.9% during core business hours.</li>\n            <li><strong>Security:</strong> All communication must be encrypted via TLS 1.3 in transit and AES-256 at rest. Role-based access enforced via JWT claims.</li>\n            <li><strong>Browser Support:</strong> Fully compatible with the latest two stable versions of Chrome, Firefox, Safari, and Edge.</li>\n        </ul>\n    </section>\n\n    <!-- SECTION 15 & 16 -->\n    <section id=\"section-15\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px; margin-bottom: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 11</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">15. Assumptions &amp; 16. Risks</h2>\n        \n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Assumptions</h3>\n        <ul>\n            <li>Enterprise users have active corporate directory entries for SSO integration.</li>\n        </ul>\n\n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Risks &amp; Mitigations</h3>\n        <table style=\"width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 10px;\">\n            <thead>\n                <tr style=\"border-bottom: 1px solid #334155; text-align: left; color: #94a3b8;\">\n                    <th style=\"padding: 10px;\">Risk Description</th>\n                    <th style=\"padding: 10px;\">Likelihood</th>\n                    <th style=\"padding: 10px;\">Impact</th>\n                    <th style=\"padding: 10px;\">Mitigation Strategy</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr style=\"border-bottom: 1px solid #334155;\">\n                    <td style=\"padding: 10px;\">IdP downtime prevents user logins.</td>\n                    <td style=\"padding: 10px;\">Low</td>\n                    <td style=\"padding: 10px;\">High</td>\n                    <td style=\"padding: 10px;\">Implement fallback token authentication caching for active sessions.</td>\n                </tr>\n            </tbody>\n        </table>\n    </section>\n\n    <!-- SECTION 18 -->\n    <section id=\"section-18\" style=\"background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 30px;\">\n        <span style=\"background-color: #22d3ee; color: #0f172a; font-size: 12px; font-weight: bold; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 15px;\">Section 12</span>\n        <h2 style=\"color: #6366f1; font-size: 24px; margin-top: 0;\">18. Appendix</h2>\n        \n        <h3 style=\"color: #e2e8f0; font-size: 18px;\">Glossary &amp; Abbreviations</h3>\n        <dl style=\"font-size: 14px;\">\n            <dt style=\"font-weight: bold; color: #22d3ee;\">FSD</dt>\n            <dd style=\"margin-left: 20px; margin-bottom: 10px;\">Functional Specification Document</dd>\n            \n            <dt style=\"font-weight: bold; color: #22d3ee;\">BRD</dt>\n            <dd style=\"margin-left: 20px; margin-bottom: 10px;\">Business Requirements Document</dd>\n            \n            <dt style=\"font-weight: bold; color: #22d3ee;\">SSO</dt>\n            <dd style=\"margin-left: 20px; margin-bottom: 10px;\">Single Sign-On</dd>\n\n            <dt style=\"font-weight: bold; color: #22d3ee;\">JWT</dt>\n            <dd style=\"margin-left: 20px; margin-bottom: 10px;\">JSON Web Token</dd>\n        </dl>\n    </section>\n\n</article>"
}